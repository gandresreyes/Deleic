---
// Logo: PNG sin pérdida (bordes nítidos y transparencia) a 1x, 2x y 3x
import { Image } from "astro:assets";
import logo from "../assets/img/deleicLogo.webp";
import { DIRECCION, HORARIO, REDES, TELEFONO, whatsapp } from "../data/contacto";

// El footer enlaza todas las páginas del sitio: algunas (Ultrasonix,
// tratamiento capilar, Contacto) no están en el menú principal
const columnas = [
  {
    titulo: "Tratamientos",
    enlaces: [
      { href: "/depilacion-laser/", nombre: "Depilación láser" },
      { href: "/facial-corporal/", nombre: "Facial y corporal" },
      { href: "/medicina-estetica/", nombre: "Medicina estética" },
      { href: "/micropigmentacion/", nombre: "Micropigmentación" },
      { href: "/facial-corporal/ultrasonix/", nombre: "Ultrasonix" },
      { href: "/facial-corporal/tratamiento-capilar/", nombre: "Tratamiento capilar" },
    ],
  },
  {
    titulo: "Deleic",
    enlaces: [
      { href: "/metodo-deleic/", nombre: "Método Deleic" },
      { href: "/promociones/", nombre: "Promociones" },
      { href: "/nosotros/", nombre: "Nosotros" },
      { href: "/contacto/", nombre: "Contacto" },
    ],
  },
];

const legales = [
  { href: "/aviso-legal/", nombre: "Aviso legal" },
  { href: "/politica-de-privacidad-y-cookies/", nombre: "Privacidad y cookies" },
];

// Perfiles oficiales (REDES, en contacto.ts). Iconos de trazo, como el resto
// del sitio; cada red nueva de REDES necesita aquí su nombre y su icono
const redes = [
  {
    href: REDES.instagram,
    nombre: "Instagram",
    icono:
      '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
  },
  {
    href: REDES.facebook,
    nombre: "Facebook",
    icono:
      '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
];

const year = new Date().getFullYear();
---

<footer class="relative isolate overflow-hidden bg-secondary-content text-base-100">
  <div
    aria-hidden="true"
    class="absolute -top-40 -right-32 -z-10 w-96 h-96 rounded-full bg-primary/40 blur-3xl"
  >
  </div>

  <!--
    Padding inferior amplio: el botón flotante "Reservar cita" (Navbar.astro)
    ocupa ~68px abajo y taparía la última línea (crédito y legales).
  -->
  <div
    class="container mx-auto px-4 sm:px-6 lg:px-8 pt-14 sm:pt-16 pb-[calc(6rem+env(safe-area-inset-bottom))]"
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-3">
        <a href="/" class="inline-block" aria-label="Deleic, ir al inicio">
          <Image
            src={logo}
            alt="Deleic"
            height={56}
            densities={[1, 2, 3]}
            format="png"
            loading="lazy"
            class="h-14 w-auto brightness-0 invert"
          />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-base-100/60">
          Centro de medicina estética y depilación láser en León. Precisión
          médica para tu mejor versión.
        </p>
        <a
          href={whatsapp()}
          target="_blank"
          rel="noopener"
          class="btn btn-primary mt-6 h-11 rounded-full px-6 border-0"
        >
          Reservar por WhatsApp
        </a>
        <ul class="mt-6 flex gap-3" aria-label="Redes sociales">
          {
            redes.map((r) => (
              <li>
                <a
                  href={r.href}
                  target="_blank"
                  rel="me noopener"
                  aria-label={`Deleic en ${r.nombre}`}
                  title={r.nombre}
                  class="flex h-11 w-11 items-center justify-center rounded-full border border-base-100/15 text-base-100/75 transition-colors hover:border-base-100/40 hover:text-base-100"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={r.icono}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-10 lg:col-span-4">
        {
          columnas.map((col) => (
            <nav aria-label={col.titulo}>
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-base-100/50">
                {col.titulo}
              </p>
              <ul class="mt-4 space-y-2.5 text-sm">
                {col.enlaces.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="text-base-100/75 transition-colors hover:text-base-100"
                    >
                      {l.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 sm:col-span-2 lg:col-span-5">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-base-100/50">
            Contacto
          </p>
          <address class="mt-4 space-y-2.5 text-sm not-italic text-base-100/75">
            <a
              href={DIRECCION.maps}
              target="_blank"
              rel="noopener"
              class="block transition-colors hover:text-base-100"
            >
              {DIRECCION.calle}<br />{DIRECCION.cp} {DIRECCION.ciudad}
            </a>
            <a href={TELEFONO.href} class="block transition-colors hover:text-base-100">
              {TELEFONO.visible}
            </a>
          </address>
        </div>

        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-base-100/50">
            Horario
          </p>
          <dl class="mt-4 space-y-1.5 text-sm text-base-100/75">
            {
              HORARIO.invierno
                .filter((f) => f.horas)
                .map((f) => (
                  <div class="flex justify-between gap-4">
                    <dt>{f.dias}</dt>
                    <dd class="tabular-nums">{f.horas}</dd>
                  </div>
                ))
            }
          </dl>
          <p class="mt-2 text-xs text-base-100/50">
            Verano:{" "}
            {HORARIO.verano
              .filter((f) => f.horas)
              .map((f) => `${f.dias} ${f.horas}`)
              .join(" · ")}
          </p>
        </div>
      </div>
    </div>

    <!-- Móvil y tablet: apilado y centrado (legales primero); desde lg, una fila -->
    <div
      class="mt-12 flex flex-col items-center gap-3 border-t border-base-100/10 pt-6 text-center text-xs text-base-100/50 lg:flex-row lg:justify-between lg:gap-6 lg:text-left"
    >
      <nav aria-label="Información legal" class="lg:order-2">
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-1">
          {
            legales.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-block py-1.5 text-base-100/60 transition-colors hover:text-base-100"
                >
                  {l.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="lg:order-1">© {year} Deleic. Todos los derechos reservados.</p>
      <p class="lg:order-3">
        Diseño y desarrollo:
        <a
          href="https://www.bygabo.dev/"
          target="_blank"
          rel="noopener"
          class="inline-block py-1.5 text-base-100/60 transition-colors hover:text-base-100"
        >
          Gabriel Reyes
        </a>
      </p>
    </div>
  </div>
</footer>
