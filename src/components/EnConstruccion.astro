---
// src/components/EnConstruccion.astro
// Aviso de página en construcción. La página que lo use debe pasar
// `noindex` a Layout para que Google no indexe una página sin contenido
import { whatsapp } from "../data/contacto";

interface Props {
  eyebrow: string;
  titulo: string;
  texto: string;
  /** Mensaje del botón de WhatsApp (por defecto, reservar cita) */
  mensaje?: string;
}
const { eyebrow, titulo, texto, mensaje } = Astro.props;

const icons = {
  herramientas:
    '<path d="M14.7 6.3a4 4 0 00-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 005.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6z"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
};
---

<section
  class="relative isolate overflow-hidden card bg-base-100 seccion-card text-secondary-content"
>
  <!-- Textura de puntos, la misma del resto del sitio -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 opacity-[0.12] bg-[radial-gradient(rgb(0_0_0/0.6)_1px,transparent_1px)] bg-size-[18px_18px] mask-[linear-gradient(to_left,black,transparent_45%)]"
  >
  </div>

  <div class="reveal max-w-2xl">
    <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary/8 text-primary">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-7 h-7"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={icons.herramientas}
      />
    </span>

    <span
      class="mt-8 block text-sm font-semibold tracking-widest uppercase text-primary"
    >
      {eyebrow}
    </span>
    <h1 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-balance">
      {titulo}
    </h1>
    <p class="mt-4 text-lg text-base-content/70 text-pretty">{texto}</p>

    <span
      class="mt-6 inline-flex items-center gap-2 rounded-full bg-base-200 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-secondary-content/70"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
      Página en construcción
    </span>

    <div class="mt-10 flex flex-wrap gap-3 font-bold">
      <a
        href={whatsapp(mensaje)}
        target="_blank"
        rel="noopener"
        class="px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-primary text-primary-content"
      >
        Escríbenos por WhatsApp
      </a>
      <a
        href="/"
        class="group inline-flex items-center gap-2 px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-base-100 text-secondary-content border border-base-300"
      >
        Volver al inicio
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 transition-transform group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icons.arrow}
        />
      </a>
    </div>
  </div>
</section>
