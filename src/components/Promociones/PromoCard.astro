---
// src/components/Promociones/PromoCard.astro
// Cartel de promoción con vista grande (popover, sin JS).
// Sin `img` se usa como plantilla: el script de /promociones/ la clona y rellena
// los elementos marcados con data-* cuando WordPress tiene contenido más nuevo.
import type { ImagenWP } from "../../lib/wordpress";

interface Props {
  img?: ImagenWP;
  i?: number;
}

const { img, i = 0 } = Astro.props;
const id = `promo-${i}`;
const nombre = img?.alt || `Promoción ${i + 1}`;
const alt = img?.alt || `Promoción ${i + 1} de Deleic`;

const icons = {
  expand: '<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
};
---

<li>
  <button
    type="button"
    data-abrir
    popovertarget={id}
    class="group flex h-full w-full cursor-zoom-in flex-col overflow-hidden rounded-3xl bg-base-100 text-left ring-1 ring-black/5 transition duration-300 motion-safe:hover:-translate-y-1 hover:shadow-xl hover:shadow-black/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    aria-label={`Ver en grande: ${nombre}`}
  >
    <span class="block overflow-hidden bg-base-200">
      <img
        data-miniatura
        src={img?.src}
        srcset={img?.srcset}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        width={img?.width}
        height={img?.height}
        alt={alt}
        loading={i < 3 ? "eager" : "lazy"}
        class="aspect-725/1024 w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
      />
    </span>

    <span class="flex flex-1 items-center justify-between gap-4 p-4 sm:p-5">
      <span class="min-w-0">
        <span data-numero class="block text-xs font-semibold tracking-widest text-primary">
          {String(i + 1).padStart(2, "0")}
        </span>
        <span data-nombre class="mt-1 block text-base font-semibold first-letter:uppercase">
          {nombre}
        </span>
      </span>
      <span
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-base-200 text-secondary-content transition-colors group-hover:bg-primary group-hover:text-primary-content"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icons.expand}
        />
      </span>
    </span>
  </button>

  <!-- Vista grande -->
  <div
    data-vista
    id={id}
    popover
    class="m-auto max-h-[92dvh] w-[min(92vw,34rem)] overflow-visible bg-transparent p-0 backdrop:bg-black/75 backdrop:backdrop-blur-sm"
  >
    <div class="relative">
      <img
        data-grande
        src={img?.src}
        srcset={img?.srcset}
        sizes="(min-width: 640px) 34rem, 92vw"
        width={img?.width}
        height={img?.height}
        alt={alt}
        loading="lazy"
        class="max-h-[92dvh] w-full rounded-3xl object-contain shadow-2xl"
      />
      <button
        type="button"
        data-cerrar
        popovertarget={id}
        popovertargetaction="hide"
        class="absolute right-3 top-3 flex h-11 w-11 items-center justify-center rounded-full bg-base-100/90 text-secondary-content shadow-lg backdrop-blur-sm"
        aria-label="Cerrar"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          set:html={icons.close}
        />
      </button>
    </div>
  </div>
</li>
