<section
  class="card seccion-card bg-secondary-content text-base-100"
  id="novedades"
  aria-labelledby="novedades-heading"
>
  <div>
    <div class="max-w-2xl mb-14 reveal">
      <span class="text-sm font-semibold tracking-widest uppercase">
        Siempre a la vanguardia
      </span>
      <h2
        id="novedades-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold"
      >
        Innovación que se nota en tu piel
      </h2>
      <p class="mt-4 text-lg text-white/65">
        En Deleic estamos en formación continua para traerte los tratamientos
        más eficaces y novedosos del sector. Esto es lo último que hemos
        incorporado a nuestro centro:
      </p>
    </div>

    <!-- Fila 1: Hydrabalance (grande) + Ultrasonix (destacada en rojo) -->
    <div class="reveal-stagger grid grid-cols-1 md:grid-cols-12 gap-5 mb-5">
      <!-- Hydrabalance -->
      <a
        href="/facial-corporal/higiene-facial/#modalidades"
        class="group relative md:col-span-8 h-85 sm:h-100 rounded-3xl overflow-hidden"
      >
        <img
          src="/img/novedades/hydrabalance.webp"
          alt="Hydrabalance"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div
          class="absolute inset-0 bg-linear-to-t from-black/85 via-black/20 to-transparent"
        >
        </div>
        <div class="absolute bottom-0 left-0 p-8 max-w-md">
          <h3 class="text-2xl sm:text-3xl font-semibold text-white mb-2">
            Hydrabalance
          </h3>
          <p class="text-sm text-white/80 leading-relaxed">
            Higiene facial con un sistema de vacío de efecto tornado: extrae
            puntos negros, impurezas y sebo mientras aporta los activos que
            necesita tu piel.
          </p>
        </div>
      </a>

      <!-- Ultrasonix (destacada) -->
      <a
        href="/ultrasonix/"
        class="group relative md:col-span-4 h-85 sm:h-100 rounded-3xl overflow-hidden p-7 flex flex-col justify-between border border-white/8 transition-all duration-300 hover:-translate-y-1 hover:border-white/[0.2] hover:shadow-2xl hover:shadow-black/50"
        style="background: radial-gradient(140% 100% at 15% 0%, var(--color-primary-claro) 0%, var(--color-primary) 45%, var(--color-primary-oscuro) 100%);"
      >
        <!-- Textura de puntos sutil para llenar el espacio vacío -->
        <div
          class="absolute
        inset-0
        opacity-[0.15]
        pointer-events-none"
          style="background-image: radial-gradient(rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 18px 18px;"
        >
        </div>

        <div class="relative flex items-center justify-between">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-8 h-8 text-white/90"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span
            class="text-[11px] font-bold tracking-wider uppercase bg-white/15 text-white px-3 py-1.5 rounded-full"
          >
            Novedad
          </span>
        </div>

        <div class="relative">
          <h3 class="text-2xl font-semibold text-white mb-2">Ultrasonix</h3>
          <p class="text-sm text-white/80 leading-relaxed mb-3">
            Ultrasonido focalizado que reafirma la piel y estimula la formación
            de nuevo colágeno, logrando un efecto lifting no quirúrgico sin
            tiempo de recuperación.
          </p>
          <span
            class="inline-flex items-center gap-1 text-sm font-medium text-white/90 group-hover:text-white"
          >
            Descubrir Ultrasonix
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </div>
      </a>
    </div>

    <!-- Fila 2: Hollywood Peel (compacta) + Nanoblading (grande) -->
    <div class="reveal-stagger grid grid-cols-1 md:grid-cols-12 gap-5">
      <!-- Hollywood Peel -->
      <a
        href="/hollywood-peel/"
        class="group relative md:col-span-4 h-75 sm:h-85 rounded-3xl overflow-hidden bg-white/6"
      >
        <img
          src="/img/novedades/hollywood-peel.webp"
          alt="Hollywood Peel"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500"
        />
        <div
          class="absolute inset-0 bg-linear-to-b from-black/80 via-black/10 to-black/40"
        >
        </div>
        <div class="absolute top-0 left-0 p-6">
          <h3 class="text-xl font-semibold text-white mb-2">Hollywood Peel</h3>
          <p class="text-sm text-white/75 leading-relaxed max-w-sm">
            Peeling con carbón activo y láser Nd:YAG que limpia los poros en
            profundidad, mejora la textura y deja un efecto luminoso inmediato,
            sin tiempo de recuperación.
          </p>
        </div>
      </a>

      <!-- Nanoblading -->

      <a
        href="/micropigmentacion/"
        class="group relative
      md:col-span-8 h-75 sm:h-85 rounded-3xl overflow-hidden bg-black/20
      flex"
      >
        <div
          class="relative z-10 w-full sm:w-1/2 p-8 flex flex-col justify-center"
        >
          <!-- Textura de puntos sutil -->
          <div
            class="absolute inset-0 opacity-[0.12] pointer-events-none"
            style="background-image: radial-gradient(rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 18px 18px;"
          >
          </div>

          <h3 class="relative text-2xl font-semibold text-white mb-2">
            Nanoblading
          </h3>
          <p class="relative text-sm text-white/75 leading-relaxed mb-4">
            Evolución del microblading con agujas ultrafinas para trazos más
            precisos, ideal si buscas un acabado natural y delicado en tus
            cejas.
          </p>
          <span
            class="relative inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:text-white transition-colors"
          >
            Saber más
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </div>
        <!-- Imagen a sangre con corte diagonal en el borde izquierdo -->
        <div
          class="hidden sm:block absolute inset-y-0 right-0 w-[55%] overflow-hidden"
          style="clip-path: polygon(0 0, 100% 0, 100% 100%, 22% 100%);"
        >
          <img
            src="/img/novedades/nanoblading.webp"
            alt="Nanoblading"
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <!-- Capa oscura para apagar la imagen; se aclara al pasar el ratón -->
          <div
            class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-500"
          >
          </div>
        </div>
      </a>
    </div>
  </div>
</section>
