---
import data from "../../data/depilacionLaser.json";

const { tecnologia } = data;
---

<section
  class="group relative overflow-hidden card seccion-card bg-secondary-content text-white"
  aria-labelledby="tecnologia-heading"
>
  <!-- Imagen -->
  <img
    src={tecnologia.imagen}
    alt={tecnologia.imagenAlt}
    width="1536"
    height="1024"
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover object-left transition-all duration-700 ease-out group-hover:scale-105 group-hover:-translate-x-6 hidden lg:block max-w-4xl"
  />
  <!-- Overlay oscuro -->
  <div aria-hidden="true" class="absolute inset-0 bg-black/40"></div>
  <!-- Contenido -->
  <div
    class="relative z-10 grid lg:grid-cols-2 backdrop-blur-[2px] lg:backdrop-blur-none"
  >
    <!-- Espacio para la imagen -->
    <div></div>

    <!-- Texto -->
    <div class="reveal max-w-xl lg:justify-self-end">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-white/70"
      >
        {tecnologia.eyebrow}
      </span>

      <h2
        id="tecnologia-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold"
      >
        {tecnologia.titulo}
      </h2>

      <p class="mt-4 text-lg leading-8 text-white/70">
        Trabajamos con el láser de diodo <strong>ENEKA PRO</strong>, equipado
        con <strong>2000W de potencia real</strong> y un avanzado sistema de enfriamiento
        por contacto que mantiene la piel protegida durante todo el tratamiento, proporcionando
        sesiones más cómodas, rápidas y seguras.
      </p>

      <!-- Características -->
      <dl class="reveal-stagger mt-10 grid gap-5 sm:grid-cols-2">
        {
          tecnologia.datos.map((d) => (
            <div class="flex flex-col-reverse rounded-3xl p-5 bg-secondary-content border border-white/10 transition-all duration-300 hover:bg-white/10 hover:border-primary/40">
              <dt class="mt-2 text-white/60">{d.texto}</dt>
              <dd class="text-3xl font-bold">{d.valor}</dd>
            </div>
          ))
        }
      </dl>

      <!-- Beneficios -->
      <ul class="mt-10 grid gap-x-2 gap-y-5 grid-cols-2">
        {
          tecnologia.beneficios.map((b) => (
            <li class="flex items-center gap-3">
              <span
                aria-hidden="true"
                class="h-2.5 w-2.5 shrink-0 rounded-full bg-primary"
              />
              <span class="text-white/80">{b}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
