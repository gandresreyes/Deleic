---
// Precios por grupo de zonas. En móvil y tablet, carrusel horizontal
// (scroll-snap); desde lg, rejilla "bento" con todo a la vista. Mismo HTML:
// solo cambian las clases según el ancho.
import data from "../../data/depilacionLaser.json";
import { whatsapp } from "../../data/contacto";

const { precios } = data;

// En la rejilla bento, las tarjetas con más zonas (y la destacada) ocupan
// dos columnas: XS | S S / M M | L / XL XL | presupuesto
const ANCHAS = new Set(["S", "M", "XL"]);
const tarjeta = "w-[80%] shrink-0 snap-start sm:w-85 lg:w-auto";

const icons = {
  prev: '<path d="M15 19l-7-7 7-7"/>',
  next: '<path d="M9 5l7 7-7 7"/>',
};

const whatsappIcon =
  '<path d="M3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 8 19.3z"/><path d="M9 8.6c.2-.4.5-.6.9-.6h.5l1 2.2-.8 1a5.6 5.6 0 0 0 2.3 2.3l1-.8 2.2 1v.5c0 .4-.2.7-.6.9a3 3 0 0 1-2.6.2 7.7 7.7 0 0 1-4.1-4.1 3 3 0 0 1 .2-2.6z"/>';
---

<section
  id="precios"
  class="seccion scroll-mt-24"
  aria-labelledby="precios-heading"
>
  <div class="reveal flex items-end justify-between gap-6">
    <div>
      <span class="text-sm font-semibold tracking-widest uppercase text-primary">
        {precios.eyebrow}
      </span>
      <h2
        id="precios-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content text-balance"
      >
        {precios.titulo}
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-base-content/70 text-pretty">
        {precios.texto}
      </p>
    </div>

    <!-- Flechas del carrusel (en táctil se desliza con el dedo; desde lg no
         hay carrusel) -->
    <div class="hidden md:flex lg:hidden shrink-0 gap-2">
      {
        (["prev", "next"] as const).map((dir) => (
          <button
            type="button"
            data-carrusel-boton={dir}
            aria-controls="carrusel-precios"
            aria-label={dir === "prev" ? "Precios anteriores" : "Más precios"}
            class="flex h-11 w-11 items-center justify-center rounded-full border border-base-300 bg-base-100 text-primary transition-colors hover:bg-base-200 disabled:opacity-40 disabled:hover:bg-base-100"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[dir]}
            />
          </button>
        ))
      }
    </div>
  </div>

  <!-- Carrusel / rejilla: py para que no se recorte la sombra al pasar el ratón -->
  <ul
    id="carrusel-precios"
    tabindex="0"
    aria-label="Precios por zona"
    class="reveal-stagger mt-4 -mb-4 flex snap-x snap-mandatory gap-4 sm:gap-5 overflow-x-auto overscroll-x-contain py-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:grid lg:grid-cols-3 lg:overflow-visible"
  >
    {
      precios.grupos.map((g) => (
        <li class:list={[tarjeta, ANCHAS.has(g.talla) && "lg:col-span-2"]}>
          <article
            class:list={[
              "relative h-full overflow-hidden rounded-3xl border p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl",
              g.destacado
                ? "border-primary bg-linear-to-br from-primary-oscuro to-primary text-primary-content"
                : "border-base-300 bg-base-100 text-secondary-content hover:border-primary/60",
            ]}
          >
            <div
              aria-hidden="true"
              class:list={[
                "pointer-events-none absolute inset-0 opacity-[0.15] bg-size-[18px_18px]",
                g.destacado
                  ? "bg-[radial-gradient(rgb(255_255_255/0.4)_1px,transparent_1px)]"
                  : "bg-[radial-gradient(rgb(0_0_0/0.6)_1px,transparent_1px)]",
              ]}
            />
            <p
              class:list={[
                "absolute right-6 top-6 rounded-full px-4 py-2 text-lg font-bold tabular-nums",
                g.destacado
                  ? "bg-white text-primary"
                  : "bg-primary text-primary-content",
              ]}
            >
              {g.precio} €
            </p>
            <span
              class:list={[
                "relative text-xs font-semibold uppercase tracking-[0.25em]",
                g.destacado ? "text-primary-content/70" : "text-primary",
              ]}
            >
              Zona {g.talla}
            </span>
            <h3 class="relative mt-4 text-2xl font-bold">{g.nombre}</h3>
            <ul class="relative mt-6 flex flex-wrap gap-2">
              {g.zonas.map((z) => (
                <li
                  class:list={[
                    "rounded-full px-3 py-1 text-sm",
                    g.destacado ? "bg-white/10" : "bg-base-200",
                  ]}
                >
                  {z}
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }

    <!-- Cierra el carrusel con la llamada a pedir presupuesto -->
    <li class={tarjeta}>
      <div
        class="flex h-full flex-col justify-between gap-6 rounded-3xl bg-secondary-content p-8 text-white"
      >
        <div>
          <h3 class="text-2xl font-bold">{precios.presupuesto.titulo}</h3>
          <p class="mt-3 text-white/70">{precios.presupuesto.texto}</p>
        </div>
        <a
          href={whatsapp(precios.presupuesto.mensaje)}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 self-start px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-white text-primary font-bold"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={whatsappIcon}
          />
          {precios.presupuesto.cta}
        </a>
      </div>
    </li>
  </ul>
</section>

<script>
  // Flechas del carrusel: avanzan una tarjeta y se desactivan en los extremos.
  // Con ClientRouter hay que engancharlas de nuevo en cada navegación
  function iniciarCarrusel() {
    const carrusel = document.getElementById("carrusel-precios");
    if (!carrusel) return;
    const botones = document.querySelectorAll<HTMLButtonElement>(
      "[data-carrusel-boton]",
    );

    const paso = () => {
      const tarjeta = carrusel.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(carrusel).columnGap) || 0;
      return (tarjeta?.offsetWidth ?? 0) + gap;
    };

    const actualizar = () => {
      const fin = carrusel.scrollWidth - carrusel.clientWidth - 1;
      botones.forEach((b) => {
        b.disabled =
          b.dataset.carruselBoton === "prev"
            ? carrusel.scrollLeft <= 0
            : carrusel.scrollLeft >= fin;
      });
    };

    botones.forEach((b) =>
      b.addEventListener("click", () => {
        const sentido = b.dataset.carruselBoton === "prev" ? -1 : 1;
        carrusel.scrollBy({ left: sentido * paso(), behavior: "smooth" });
      }),
    );
    carrusel.addEventListener("scroll", actualizar, { passive: true });
    actualizar();
  }

  document.addEventListener("astro:page-load", iniciarCarrusel);
</script>
