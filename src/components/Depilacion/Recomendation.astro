---
// components/laser/Recomendaciones.astro

// tipo: "restriccion" (no hagas esto) | "accion" (sí haz esto)
const antes = [
  {
    dias: "21",
    label: "días antes",
    texto: "Sin rayos UVA ni autobronceadores",
    tipo: "restriccion",
    icon: "sun-off",
  },
  {
    dias: "20",
    label: "días antes",
    texto: "No depilar con cera ni pinzas",
    tipo: "restriccion",
    icon: "razor-off",
  },
  {
    dias: "15",
    label: "días antes",
    texto: "Evita el sol en la zona",
    tipo: "restriccion",
    icon: "sun-off",
  },
  {
    dias: "3",
    label: "días antes",
    texto: "Sin ácido glicólico ni retinoico",
    tipo: "restriccion",
    icon: "droplet-off",
  },
  {
    dias: "0",
    label: "día de la sesión",
    texto: "Rasura la zona y ven sin maquillaje",
    tipo: "accion",
    icon: "razor",
  },
];

const despues = [
  {
    dias: "2-3",
    label: "días después",
    texto: "Espera antes de exponer la zona al sol",
    tipo: "restriccion",
    icon: "sun-off",
  },
  {
    dias: "Siempre",
    label: "",
    texto: "Usa protección solar SPF 50",
    tipo: "accion",
    icon: "shield-check",
  },
];

const icons: Record<string, string> = {
  "sun-off":
    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36-6.36l-1.42 1.42M7.05 16.95l-1.42 1.42m0-12.73l1.42 1.42M16.95 16.95l1.42 1.42M3 3l18 18" /><circle cx="12" cy="12" r="4" stroke-linecap="round" stroke-linejoin="round" />',
  "razor-off":
    '<path stroke-linecap="round" stroke-linejoin="round" d="M4 4l16 16M9 9l6 6M7 7l10 10" />',
  razor:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M6 4l12 12M6 16L18 4M6 4l0 4M6 20l0 -4" />',
  "droplet-off":
    '<path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M12 3s5 5.5 5 9.5a5 5 0 01-8.9 3.1M8.2 15.8A5 5 0 017 12.5c0-1.7.9-3.3 2-4.7" />',
  "shield-check":
    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9.5 12l1.8 1.8L14.5 10" />',
};
---

<section
  class="seccion scroll-mt-24"
  id="recomendaciones"
  aria-labelledby="recomendaciones-heading"
>
  <div>
    <div class="reveal mb-4">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        Antes y después
      </span>
      <h2
        id="recomendaciones-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        Cómo preparar tu piel
      </h2>
    </div>

    <!-- ANTES: contador de días -->
    <h3 class="text-sm font-semibold text-secondary-content mb-4">
      Antes de la sesión
    </h3>
    <div class="reveal-stagger grid grid-cols-2 sm:grid-cols-5 gap-3 mb-16">
      {
        antes.map((item) => (
          <div class="bg-base-100 rounded-3xl border border-black/6 p-5 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <div>
                <span class="text-2xl font-semibold text-secondary-content">
                  {item.dias}
                </span>
                <p class="text-[11px] text-secondary-content/50 uppercase tracking-wide">
                  {item.label}
                </p>
              </div>
              <div
                class:list={[
                  "w-8 h-8 rounded-full flex items-center justify-center shrink-0",
                  item.tipo === "restriccion"
                    ? "bg-primary/10"
                    : "bg-secondary-content/10",
                ]}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class:list={[
                    "w-4 h-4",
                    item.tipo === "restriccion"
                      ? "text-primary"
                      : "text-secondary-content",
                  ]}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.6"
                  set:html={icons[item.icon]}
                />
              </div>
            </div>
            <p class="text-sm text-secondary-content/70 leading-snug mt-auto">
              {item.texto}
            </p>
          </div>
        ))
      }
    </div>

    <!-- DESPUÉS -->
    <h3 class="text-sm font-semibold text-secondary-content mb-4">
      Después de la sesión
    </h3>
    <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 gap-3">
      {
        despues.map((item) => (
          <div class="bg-base-100 rounded-3xl border border-black/[0.06] p-5 flex items-center gap-4">
            <div
              class:list={[
                "w-10 h-10 rounded-full flex items-center justify-center shrink-0",
                item.tipo === "restriccion"
                  ? "bg-primary/10"
                  : "bg-secondary-content/10",
              ]}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class:list={[
                  "w-5 h-5",
                  item.tipo === "restriccion"
                    ? "text-primary"
                    : "text-secondary-content",
                ]}
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.6"
                set:html={icons[item.icon]}
              />
            </div>
            <div>
              <span class="text-sm font-semibold text-secondary-content">
                {item.dias}
                {item.label ? ` ${item.label}` : ""}
              </span>
              <p class="text-sm text-secondary-content/60 leading-snug">{item.texto}</p>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-xs text-secondary-content/50 leading-relaxed max-w-xl">
      Estas recomendaciones son generales. Ante dudas específicas sobre tu piel
      o medicación, consulta siempre con nuestro equipo antes de tu sesión.
    </p>
  </div>
</section>
