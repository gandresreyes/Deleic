---
// Cuidados antes y después de la sesión.
// tipo: "restriccion" (no hagas esto) | "accion" (sí haz esto)
import data from "../../data/depilacionLaser.json";

const { recomendaciones } = data;

const icons: Record<string, string> = {
  "sun-off":
    '<path d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36-6.36l-1.42 1.42M7.05 16.95l-1.42 1.42m0-12.73l1.42 1.42M16.95 16.95l1.42 1.42M3 3l18 18"/><circle cx="12" cy="12" r="4"/>',
  "razor-off": '<path d="M4 4l16 16M9 9l6 6M7 7l10 10"/>',
  razor: '<path d="M6 4l12 12M6 16L18 4M6 4l0 4M6 20l0 -4"/>',
  "droplet-off":
    '<path d="M3 3l18 18M12 3s5 5.5 5 9.5a5 5 0 01-8.9 3.1M8.2 15.8A5 5 0 017 12.5c0-1.7.9-3.3 2-4.7"/>',
  "shield-check":
    '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9.5 12l1.8 1.8L14.5 10"/>',
};

const esRestriccion = (tipo: string) => tipo === "restriccion";
---

<section
  class="seccion scroll-mt-24"
  id="recomendaciones"
  aria-labelledby="recomendaciones-heading"
>
  <div>
    <div class="reveal mb-4">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {recomendaciones.eyebrow}
      </span>
      <h2
        id="recomendaciones-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {recomendaciones.titulo}
      </h2>
    </div>

    <!-- ANTES: contador de días -->
    <h3 class="text-sm font-semibold text-secondary-content mb-4">
      Antes de la sesión
    </h3>
    <ol class="reveal-stagger grid grid-cols-2 sm:grid-cols-5 gap-3 mb-16">
      {
        recomendaciones.antes.map((item) => (
          <li class="bg-base-100 rounded-3xl border border-black/6 p-5 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <div>
                <span class="text-2xl font-semibold text-secondary-content">
                  {item.dias}
                </span>
                <p class="text-[11px] text-secondary-content/50 uppercase tracking-wide">
                  {item.label}
                </p>
              </div>
              <div
                class:list={[
                  "w-8 h-8 rounded-full flex items-center justify-center shrink-0",
                  esRestriccion(item.tipo)
                    ? "bg-primary/10"
                    : "bg-secondary-content/10",
                ]}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class:list={[
                    "w-4 h-4",
                    esRestriccion(item.tipo)
                      ? "text-primary"
                      : "text-secondary-content",
                  ]}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icons[item.icono]}
                />
              </div>
            </div>
            <p class="text-sm text-secondary-content/70 leading-snug mt-auto">
              {item.texto}
            </p>
          </li>
        ))
      }
    </ol>

    <!-- DESPUÉS -->
    <h3 class="text-sm font-semibold text-secondary-content mb-4">
      Después de la sesión
    </h3>
    <ul class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 gap-3">
      {
        recomendaciones.despues.map((item) => (
          <li class="bg-base-100 rounded-3xl border border-black/6 p-5 flex items-center gap-4">
            <div
              class:list={[
                "w-10 h-10 rounded-full flex items-center justify-center shrink-0",
                esRestriccion(item.tipo)
                  ? "bg-primary/10"
                  : "bg-secondary-content/10",
              ]}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class:list={[
                  "w-5 h-5",
                  esRestriccion(item.tipo)
                    ? "text-primary"
                    : "text-secondary-content",
                ]}
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[item.icono]}
              />
            </div>
            <div>
              <span class="text-sm font-semibold text-secondary-content">
                {item.dias}
                {item.label ? ` ${item.label}` : ""}
              </span>
              <p class="text-sm text-secondary-content/60 leading-snug">
                {item.texto}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-xs text-secondary-content/50 leading-relaxed max-w-xl">
      {recomendaciones.aviso}
    </p>
  </div>
</section>
