---
// src/components/ServicesGrid.astro
interface Service {
  slug: string;
  title: string;
  eyebrow: string;
  description: string;
  href: string;
  /** La misma foto del hero de su página (así la transición enlaza ambas) */
  imagen: string;
  imagenAlt: string;
  /** Encuadre dentro de la tarjeta (object-position) */
  posicion?: string;
}

const services: Service[] = [
  {
    slug: "depilacion-laser",
    title: "Depilación láser",
    eyebrow: "Diodo de alta potencia",
    description:
      "Eliminación progresiva del vello con láser ENEKA PRO, sin dañar la piel.",
    href: "/depilacion-laser/",
    imagen: "/img/depilacion/hero.webp",
    imagenAlt: "Sesión de depilación láser en Deleic",
    posicion: "object-[50%_12%]",
  },
  {
    slug: "medicina-estetica",
    title: "Medicina estética",
    eyebrow: "Rejuvenecimiento no invasivo",
    description:
      "Ácido hialurónico, hilos tensores y toxina botulínica para resultados naturales, sin cirugía.",
    href: "/medicina-estetica/",
    imagen: "/img/medicinaEstetica/hero.webp",
    imagenAlt: "Tratamiento de medicina estética en Deleic",
    posicion: "object-[50%_40%]",
  },
  {
    slug: "facial-corporal",
    title: "Facial y corporal",
    eyebrow: "Diagnóstico personalizado",
    description:
      "Higiene profunda, radiofrecuencia y aparatología a medida de cada tipo de piel.",
    href: "/facial-corporal/",
    imagen: "/img/facialCorporal/hero.webp",
    imagenAlt: "Diagnóstico facial en Deleic",
  },
  {
    slug: "micropigmentacion",
    title: "Microblading y micropigmentación",
    eyebrow: "Maquillaje semipermanente",
    description:
      "Cejas pelo a pelo o sombreado con dermógrafo, según el acabado y duración que busques.",
    href: "/micropigmentacion/",
    imagen: "/img/results/nano-Blandon-despues.webp",
    imagenAlt: "Resultado de nanoblading de cejas en Deleic",
    posicion: "object-left",
  },
];
---

<section
  id="servicios"
  class="seccion scroll-mt-24 text-secondary-content"
>
  <div class="max-w-2xl reveal">
    <span class="text-sm font-semibold tracking-widest uppercase text-primary">
      Especialidades
    </span>
    <h2
      class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-balance"
    >
      Nuestros servicios
    </h2>
    <p class="mt-4 text-lg text-secondary-content/70 text-pretty">
      Cuatro especialidades, un mismo criterio médico-estético en León.
    </p>
  </div>

  <div
    class="reveal-stagger mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5"
  >
    {
      services.map((service) => (
        <a
          href={service.href}
          class="group flex flex-col overflow-hidden rounded-3xl bg-base-100 ring-1 ring-black/5 transition-all duration-300 motion-safe:hover:-translate-y-1 hover:shadow-xl hover:shadow-black/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <div class="relative aspect-4/3 overflow-hidden bg-base-200">
            <img
              src={service.imagen}
              alt={service.imagenAlt}
              loading="lazy"
              class:list={[
                "absolute inset-0 h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105",
                service.posicion,
              ]}
              transition:name={service.slug}
            />
          </div>

          <div class="flex flex-1 flex-col p-6">
            <span class="text-[11px] font-semibold uppercase tracking-widest text-primary">
              {service.eyebrow}
            </span>
            <h3 class="mt-2 text-xl font-semibold leading-snug text-balance">
              {service.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-secondary-content/70 text-pretty">
              {service.description}
            </p>
            <span class="mt-auto pt-5 inline-flex items-center gap-1.5 text-sm font-medium group-hover:text-primary transition-colors">
              Ver tratamientos
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14m-5-5l5 5-5 5" />
              </svg>
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
