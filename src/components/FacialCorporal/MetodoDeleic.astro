---
// src/components/FacialCorporal/MetodoDeleic.astro
// Diagnóstico facial 3D (Método Deleic) dentro de una ficha de tratamiento:
// - "alternativa": en el diagnóstico gratuito. Bloque completo con foto y
//   explicación, porque ahí es una opción nueva que hay que presentar.
// - "primer-paso": en los tratamientos que empiezan por él (despigmentante).
//   Versión compacta: el tratamiento ya explica el diagnóstico en su texto,
//   aquí solo se recuerda con el precio y el enlace.
// Texto y precio salen de metodoDeleic.json, igual que en la home y en /metodo-deleic/.
import { whatsapp } from "../../data/contacto";
import metodo from "../../data/metodoDeleic.json";
import Foto from "../Foto.astro";
import { sizesCubre } from "../../lib/imagenes";

interface Props {
  modo: "alternativa" | "primer-paso";
  /** Número de la sección en el índice de la página ("02") */
  num: string;
}
const { modo, num } = Astro.props;

const icons = {
  arrow: '<path d="M5 12h14m-5-5l5 5-5 5"/>',
  whatsapp:
    '<path d="M3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 8 19.3z"/><path d="M9 8.6c.2-.4.5-.6.9-.6h.5l1 2.2-.8 1a5.6 5.6 0 0 0 2.3 2.3l1-.8 2.2 1v.5c0 .4-.2.7-.6.9a3 3 0 0 1-2.6.2 7.7 7.7 0 0 1-4.1-4.1 3 3 0 0 1 .2-2.6z"/>',
};
---

{
  modo === "primer-paso" ? (
    <section
      id="diagnostico-3d"
      aria-labelledby="diagnostico-3d-titulo"
      class="reveal scroll-mt-28 relative isolate overflow-hidden rounded-4xl bg-secondary-content text-base-100 p-5 sm:p-6"
    >
      <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-6">
        <div class="flex items-center gap-4 sm:gap-5 flex-1 min-w-0">
          <Foto
            src="/img/metodo-deleic/metodo.webp"
            sizes="(min-width: 640px) 96px, 80px"
            alt="Rostro con media cara en mapa de calor, como en el análisis facial 3D"
            loading="lazy"
            class="shrink-0 w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover object-[center_25%] ring-1 ring-white/10"
          />
          <div class="min-w-0">
            <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest">
              <span class="tabular-nums text-base-100/70">{num}</span>
              <span class="h-px w-6 bg-base-100/30" aria-hidden="true" />
              <span class="text-base-100/60">Tu primer paso</span>
            </div>
            <h2
              id="diagnostico-3d-titulo"
              class="mt-1.5 text-xl sm:text-2xl font-semibold tracking-tight"
            >
              Diagnóstico facial 3D
            </h2>
            <p class="mt-1 text-sm text-base-100/70 leading-snug text-pretty">
              <strong class="font-semibold text-base-100">
                {metodo.precio.visible}
              </strong>{" "}
              · {metodo.oferta.descuento}.
            </p>
          </div>
        </div>

        <a
          href="/metodo-deleic/"
          class="btn h-11 px-5 rounded-full border-0 bg-base-100 text-primary hover:bg-base-200 shrink-0"
        >
          Conocer el Método Deleic
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons.arrow}
          />
        </a>
      </div>
    </section>
  ) : (
    <section
      id="diagnostico-3d"
      aria-labelledby="diagnostico-3d-titulo"
      class="reveal scroll-mt-28 relative isolate overflow-hidden rounded-4xl bg-secondary-content text-base-100 grid grid-cols-1 sm:grid-cols-12"
    >
      {/* Foto: el rostro con medio mapa de calor, como en el análisis */}
      <div class="relative h-56 sm:h-auto sm:min-h-full sm:col-span-5">
        <Foto
          src="/img/metodo-deleic/metodo.webp"
          sizes={sizesCubre("/img/metodo-deleic/metodo.webp", [
            ["(min-width: 1280px)", "42vw", 1.1],
            ["(min-width: 640px)", "42vw", 0.55],
            ["", "100vw", 1.46],
          ])}
          alt="Rostro con media cara en mapa de calor, como en el análisis facial 3D"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover object-[center_25%]"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-linear-to-t from-secondary-content via-secondary-content/10 to-transparent sm:bg-linear-to-l"
        />
      </div>

      <div class="relative sm:col-span-7 p-6 sm:p-8 lg:p-10">
        <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest">
          <span class="tabular-nums text-base-100/70">{num}</span>
          <span class="h-px w-8 bg-base-100/30" aria-hidden="true" />
          <span class="text-base-100/60">Otra opción</span>
        </div>
        <h2
          id="diagnostico-3d-titulo"
          class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-balance"
        >
          Diagnóstico facial 3D
          <span class="block text-base font-medium text-base-100/60">
            Método Deleic
          </span>
        </h2>
        <p class="mt-4 text-base-100/80 leading-relaxed text-pretty">
          Si quieres ir un paso más allá del diagnóstico gratuito, te lo
          hacemos con cámara 3D. {metodo.queEs.antes}
          <strong class="font-semibold text-base-100">
            {metodo.queEs.destacado}
          </strong>
          {metodo.queEs.despues}
        </p>

        <div class="mt-6 flex items-center gap-4 border-t border-base-100/15 pt-6">
          <span class="text-4xl font-semibold tracking-tight tabular-nums">
            {metodo.precio.visible}
          </span>
          <p class="max-w-60 text-sm leading-snug text-base-100/70">
            {metodo.oferta.descuento}.
          </p>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row sm:flex-wrap gap-3">
          <a
            href="/metodo-deleic/"
            class="btn h-12 px-6 rounded-full border-0 bg-base-100 text-primary hover:bg-base-200"
          >
            Conocer el Método Deleic
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons.arrow}
            />
          </a>
          <a
            href={whatsapp(metodo.oferta.cta.mensaje)}
            target="_blank"
            rel="noopener"
            class="btn h-12 px-6 rounded-full bg-transparent text-base-100 border-base-100/30 hover:bg-base-100/10 hover:border-base-100/50 shadow-none"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons.whatsapp}
            />
            Reservar
          </a>
        </div>
      </div>
    </section>
  )
}
