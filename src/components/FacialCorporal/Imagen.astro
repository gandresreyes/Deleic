---
// src/components/FacialCorporal/Imagen.astro
// Foto de un tratamiento o, si todavía no tiene, un fondo de marca con su
// icono. Recibe las mismas clases que la <img> para ocupar el mismo hueco.
// La foto es una <Foto> con object-cover: `tramos` describe la caja en cada
// tamaño de pantalla (ver sizesCubre en src/lib/imagenes.ts).
import Foto from "../Foto.astro";
import { sizesCubre } from "../../lib/imagenes";

interface Props {
  src?: string;
  alt: string;
  tramos: [media: string, ancho: string, caja: number][];
  icono?: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  transitionName?: string;
}

const {
  src,
  alt,
  tramos,
  icono,
  class: clase,
  loading,
  fetchpriority,
  transitionName,
} = Astro.props;

// Iconos (trazo, 24x24)
const iconos: Record<string, string> = {
  capilar:
    '<path d="M7 21c0-5 1.5-7 1.5-11S7 4 7 3"/><path d="M12 21c0-5 1.5-7 1.5-11S12 4 12 3"/><path d="M17 21c0-5 1.5-7 1.5-11S17 4 17 3"/>',
  sparkles:
    '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>',
};
---

{
  src ? (
    <Foto
      src={src}
      alt={alt}
      sizes={sizesCubre(src, tramos)}
      loading={loading}
      fetchpriority={fetchpriority}
      class={clase}
      transition:name={transitionName}
    />
  ) : (
    <div
      role="img"
      aria-label={alt}
      class:list={[clase, "isolate flex items-center justify-center bg-primary"]}
      transition:name={transitionName}
    >
      {/* El mismo burdeos que el hero y los packs del sitio */}
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-[radial-gradient(110%_80%_at_100%_0%,var(--color-primary-claro)_0%,transparent_60%),radial-gradient(80%_70%_at_0%_100%,var(--color-primary-oscuro)_0%,transparent_65%)]"
      />
      <div
        aria-hidden="true"
        class="absolute inset-0 opacity-[0.12] bg-[radial-gradient(rgb(255_255_255/0.7)_1px,transparent_1px)] bg-size-[16px_16px]"
      />
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="relative w-1/4 max-w-24 h-auto text-base-100/40"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={iconos[icono ?? "sparkles"] ?? iconos.sparkles}
      />
    </div>
  )
}
