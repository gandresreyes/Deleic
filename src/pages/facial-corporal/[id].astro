---
// src/pages/facial-corporal/[id].astro
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Imagen from "../../components/FacialCorporal/Imagen.astro";
import { urlImagen } from "../../lib/imagenes";
import MetodoDeleic from "../../components/FacialCorporal/MetodoDeleic.astro";
import { TELEFONO, whatsapp } from "../../data/contacto";
import { faqPage, migas, negocio } from "../../lib/schema";
import { numero, preciosFacial } from "../../lib/precios";
import { conEnlaces } from "../../lib/texto";

export async function getStaticPaths() {
  const todos = await getCollection("facialCorporal");
  const lista = todos.filter(
    (x) => x.data.slug !== "diagnostico-facial-corporal",
  );

  return todos.map((t) => {
    // 3 tratamientos "siguientes" en la lista, para enlazado interno
    const otros = lista.filter((x) => x.id !== t.id);
    const inicio =
      Math.max(
        lista.findIndex((x) => x.id === t.id),
        0,
      ) % Math.max(otros.length, 1);
    const relacionados = [
      ...otros.slice(inicio),
      ...otros.slice(0, inicio),
    ].slice(0, 3);

    return { params: { id: t.id }, props: { tratamiento: t, relacionados } };
  });
}

const { tratamiento, relacionados } = Astro.props;
const t = tratamiento.data;

// Reserva por WhatsApp con el tratamiento ya indicado en el mensaje. Por
// defecto se reserva el diagnóstico gratuito; `reserva` en el JSON lo cambia
const reserva = t.reserva ?? {
  texto: "Reservar diagnóstico gratuito",
  mensaje:
    t.slug === "diagnostico-facial-corporal"
      ? "Hola, me gustaría reservar el diagnóstico facial-corporal gratuito."
      : `Hola, me gustaría reservar un diagnóstico gratuito para ${t.nombre}.`,
};
const reservaHref = whatsapp(reserva.mensaje);

// Enlaces dentro del texto: sobre el burdeos del hero van en blanco
const enlaceHero =
  "font-medium text-base-100 underline decoration-base-100/40 underline-offset-4 hover:decoration-base-100";

// Eyebrow de las modalidades: "Cuatro formas de hacerlo"…
const enLetra = ["", "Una", "Dos", "Tres", "Cuatro", "Cinco", "Seis"];
const nModalidades = t.modalidades?.length ?? 0;
const modalidadesEyebrow =
  t.modalidadesEyebrow ??
  (nModalidades > 1 && enLetra[nModalidades]
    ? `${enLetra[nModalidades]} formas de hacerlo`
    : "Modalidades");

// Iconos (trazo, 24x24)
const icons: Record<string, string> = {
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  repeat:
    '<path d="M4 12V9a3 3 0 013-3h13m0 0l-3-3m3 3l-3 3M20 12v3a3 3 0 01-3 3H4m0 0l3 3m-3-3l3-3"/>',
  cpu: '<rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  sparkles:
    '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>',
  check: '<path d="M5 12l5 5L20 7"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 016-6h4a6 6 0 016 6v1"/>',
  alert: '<circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/>',
  shield:
    '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9.5 12l1.8 1.8L14.5 10"/>',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  arrow: '<path d="M5 12h14m-5-5l5 5-5 5"/>',
  chevron: '<path d="M9 6l6 6-6 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  whatsapp:
    '<path d="M3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 8 19.3z"/><path d="M9 8.6c.2-.4.5-.6.9-.6h.5l1 2.2-.8 1a5.6 5.6 0 0 0 2.3 2.3l1-.8 2.2 1v.5c0 .4-.2.7-.6.9a3 3 0 0 1-2.6.2 7.7 7.7 0 0 1-4.1-4.1 3 3 0 0 1 .2-2.6z"/>',
  tag: '<path d="M3 12V4a1 1 0 011-1h8l9 9-9 9-9-9z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
};

// Primer paso: el diagnóstico gratuito, salvo que el JSON indique otro
// (el valor por defecto está en content.config.ts)
const primerPaso = t.primerPaso;

// Ficha rápida: solo aparecen los datos que existan en el JSON,
// más el primer paso, que aplica a todos los tratamientos
const ficha = [
  t.duracionSesion && {
    icon: "clock",
    label: "Duración",
    value: t.duracionSesion,
  },
  t.sesionesRecomendadas && {
    icon: "repeat",
    label: "Sesiones",
    value: t.sesionesRecomendadas,
  },
  t.tecnologiaOMarca && {
    icon: "cpu",
    label: "Tecnología",
    value: t.tecnologiaOMarca,
  },
  t.resultado && { icon: "sparkles", label: "Resultado", value: t.resultado },
  primerPaso && {
    icon: "calendar",
    label: "Primer paso",
    value: primerPaso.texto,
    href: primerPaso.href,
  },
].filter(Boolean) as {
  icon: string;
  label: string;
  value: string;
  href?: string;
}[];

const tieneCuidados =
  (t.cuidados && t.cuidados.length > 0) ||
  (t.contraindicaciones && t.contraindicaciones.length > 0);

// Secciones presentes: alimentan el índice y la numeración
const secciones = [
  { id: "que-es", label: "En qué consiste", show: true },
  {
    id: "diagnostico-3d",
    label: "Diagnóstico facial 3D",
    show: !!t.metodoDeleic,
  },
  {
    id: "modalidades",
    label: t.modalidadesTitulo ?? "Modalidades",
    show: !!t.modalidades?.length,
  },
  { id: "para-quien", label: "Para quién es", show: !!t.paraQuienEs },
  { id: "beneficios", label: "Beneficios", show: t.beneficios.length > 0 },
  {
    id: "novedad",
    label: `Novedad: ${t.novedad?.nombre}`,
    show: !!t.novedad,
  },
  { id: "proceso", label: "Cómo se trabaja", show: !!t.proceso?.length },
  {
    id: "frecuencia",
    label: t.frecuencia?.titulo ?? "Frecuencia de las sesiones",
    show: !!t.frecuencia,
  },
  { id: "tarifas", label: "Tarifas", show: !!t.tarifas?.length },
  { id: "cuidados", label: "Cuidados", show: tieneCuidados },
  { id: "faq", label: "Preguntas frecuentes", show: !!t.faq?.length },
].filter((s) => s.show);

const num = (id: string) =>
  String(secciones.findIndex((s) => s.id === id) + 1).padStart(2, "0");

// Schema.org: Service (con sus tarifas) + BreadcrumbList (+ FAQPage)
const site = Astro.site ?? Astro.url;
const precios = preciosFacial(t);
const graph: Record<string, unknown>[] = [
  {
    "@type": "Service",
    name: t.nombre,
    serviceType: t.categoria,
    description: t.seoDescription,
    areaServed: "León",
    url: new URL(`/facial-corporal/${tratamiento.id}/`, site).href,
    ...(t.imagen && { image: new URL(urlImagen(t.imagen), site).href }),
    provider: negocio(site),
    ...(precios.length > 0 && {
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: `Tarifas de ${t.nombre}`,
        itemListElement: precios.map((p) => {
          const valor = numero(p.precio) ?? undefined;
          const esDesde = /^desde/i.test(p.precio);
          return {
            "@type": "Offer",
            name: p.grupo === t.nombre ? p.concepto : `${p.grupo} · ${p.concepto}`,
            ...(p.nota && { description: p.nota }),
            priceCurrency: "EUR",
            ...(esDesde
              ? {
                  priceSpecification: {
                    "@type": "PriceSpecification",
                    minPrice: valor,
                    priceCurrency: "EUR",
                  },
                }
              : { price: valor }),
          };
        }),
      },
    }),
  },
  migas(site, [
    ["Facial & Corporal", "/facial-corporal/"],
    [t.nombre, `/facial-corporal/${tratamiento.id}/`],
  ]),
];
if (t.faq?.length) graph.push(faqPage(t.faq));
const schema = { "@context": "https://schema.org", "@graph": graph };
---

<Layout
  title={t.seoTitle}
  description={t.seoDescription}
  image={t.imagen}
  imageAlt={t.imagenAlt}
>
  <div
    id="tratamiento"
    class="pila text-secondary-content"
  >
    <!-- 1. HERO -->
    <section
      class="relative isolate overflow-hidden rounded-4xl bg-primary text-base-100"
    >
      <!-- Capas de textura: luz, grano y puntos que siguen al cursor -->
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-[radial-gradient(110%_80%_at_100%_0%,var(--color-primary-claro)_0%,transparent_60%),radial-gradient(80%_70%_at_0%_100%,var(--color-primary-oscuro)_0%,transparent_65%)]"
      >
      </div>
      <div
        aria-hidden="true"
        class="tex-grain absolute inset-0 -z-10 opacity-40 mix-blend-soft-light"
      >
      </div>
      <div aria-hidden="true" class="textura-cursor"></div>
      <div
        aria-hidden="true"
        class="absolute -left-24 -bottom-32 -z-10 w-80 h-80 rounded-full border border-base-100/10"
      >
      </div>
      <div
        aria-hidden="true"
        class="absolute -left-10 -bottom-20 -z-10 w-56 h-56 rounded-full border border-base-100/10"
      >
      </div>

      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 p-5 sm:p-8 lg:p-12 pb-20 sm:pb-24 lg:pb-24"
      >
        <div class="lg:col-span-7 flex flex-col">
          <nav aria-label="Migas de pan" class="text-sm text-base-100/60">
            <ol class="flex flex-wrap items-center gap-1.5">
              <li>
                <a href="/" class="hover:text-base-100 transition-colors"
                  >Inicio</a
                >
              </li>
              <li aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons.chevron}
                />
              </li>
              <li>
                <a
                  href="/facial-corporal/"
                  class="hover:text-base-100 transition-colors"
                  >Facial & Corporal</a
                >
              </li>
              <li aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons.chevron}
                />
              </li>
              <li
                class="text-base-100/90 truncate max-w-[16ch] sm:max-w-none"
                aria-current="page"
              >
                {t.nombre}
              </li>
            </ol>
          </nav>

          <div class="mt-8 lg:mt-auto lg:pt-12">
            <span
              class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] bg-base-100/10 ring-1 ring-base-100/20 backdrop-blur-sm px-3 py-1.5 rounded-full"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-base-100"
                aria-hidden="true"></span>
              {t.eyebrow}
            </span>
            <h1
              class="mt-5 text-[2.1rem] leading-[1.1] sm:text-5xl lg:text-[3.4rem] font-semibold tracking-tight text-balance"
            >
              {t.tituloHero}
            </h1>
            <p
              class="mt-5 text-base sm:text-lg text-base-100/75 max-w-xl leading-relaxed text-pretty"
              set:html={conEnlaces(t.subtituloHero, enlaceHero)}
            />

            {
              t.novedad && (
                <a
                  href="#novedad"
                  class="group mt-6 inline-flex items-center gap-2 rounded-full bg-base-100/10 py-1.5 pl-1.5 pr-4 text-sm ring-1 ring-base-100/20 backdrop-blur-sm hover:bg-base-100/15 transition-colors"
                >
                  <span class="rounded-full bg-base-100 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-primary">
                    Novedad
                  </span>
                  <span class="font-medium">{t.novedad.nombre}</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={icons.arrow}
                  />
                </a>
              )
            }

            <div class="mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-3">
              <a
                href={reservaHref}
                target="_blank"
                rel="noopener"
                class="btn h-12 px-7 rounded-full border-0 bg-base-100 text-primary hover:bg-base-200 shadow-lg shadow-black/20"
              >
                {reserva.texto}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons.arrow}
                />
              </a>
              <a
                href={TELEFONO.href}
                class="btn h-12 px-6 rounded-full bg-transparent text-base-100 border-base-100/30 hover:bg-base-100/10 hover:border-base-100/50 shadow-none"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons.phone}
                />
                {TELEFONO.visible}
              </a>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div
            class="relative aspect-4/3 sm:aspect-16/10 lg:aspect-4/5 rounded-3xl overflow-hidden bg-base-100/10 ring-1 ring-base-100/15 shadow-2xl shadow-black/30"
          >
            <Imagen
              src={t.imagen}
              alt={t.imagenAlt}
              tramos={[
                ["(min-width: 1536px)", "600px", 0.8],
                ["(min-width: 1024px)", "40vw", 0.8],
                ["(min-width: 640px)", "100vw", 1.6],
                ["", "100vw", 4 / 3],
              ]}
              icono={t.icono}
              fetchpriority="high"
              class="absolute inset-0 w-full h-full object-cover"
              transitionName={t.id}
            />
            <div
              aria-hidden="true"
              class="absolute inset-0 bg-linear-to-t from-black/50 via-transparent to-transparent"
            >
            </div>
            <span
              class="absolute left-4 bottom-4 text-[11px] font-semibold uppercase tracking-wider bg-base-100/90 backdrop-blur-sm text-primary px-3 py-1.5 rounded-full"
            >
              {t.categoria}
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. FICHA RÁPIDA -->
    <section
      aria-label="Ficha del tratamiento"
      class="relative z-10 -mt-12 mx-2 sm:mx-6 lg:mx-12"
    >
      <ul
        class="grid gap-3 grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))]"
      >
        {
          ficha.map((f) => (
            <li class="flex items-start gap-4 bg-base-100 rounded-3xl p-4 sm:p-5 ring-1 ring-black/5 shadow-xl shadow-black/5">
              <span class="shrink-0 w-11 h-11 rounded-xl bg-primary/8 text-primary flex items-center justify-center ring-1 ring-primary/10">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[f.icon]}
                />
              </span>
              <div class="min-w-0">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-secondary-content/65">
                  {f.label}
                </p>
                <p class="mt-1 text-sm font-medium text-secondary-content leading-snug text-pretty">
                  {f.href ? (
                    <a
                      href={f.href}
                      class="text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary"
                    >
                      {f.value}
                    </a>
                  ) : (
                    f.value
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Índice móvil (desplazable en horizontal) -->
    {
      secciones.length > 1 && (
        <nav
          aria-label="En esta página"
          class="lg:hidden -mx-4 sm:-mx-6 px-4 sm:px-6 overflow-x-auto scrollbar-none [&::-webkit-scrollbar]:hidden"
        >
          <ul class="flex gap-2 w-max">
            {secciones.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="flex items-center gap-2 whitespace-nowrap rounded-full bg-base-100 ring-1 ring-black/5 px-4 py-2.5 text-sm font-medium text-secondary-content/80 active:bg-primary active:text-primary-content"
                >
                  <span class="text-[11px] font-semibold tabular-nums text-primary">
                    {num(s.id)}
                  </span>
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <!-- 3. CONTENIDO + ASIDE -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start"
    >
      <div class="lg:col-span-8 space-y-6 sm:space-y-8">
        <!-- Qué es -->
        <section
          id="que-es"
          class="reveal scroll-mt-28 rounded-4xl bg-base-100 seccion-card ring-1 ring-black/5"
        >
          <div
            class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest"
          >
            <span class="tabular-nums text-primary">{num("que-es")}</span>
            <span class="h-px w-8 bg-primary/30" aria-hidden="true"></span>
            <span class="text-secondary-content/65">El tratamiento</span>
          </div>
          <h2
            class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-balance"
          >
            ¿En qué consiste?
          </h2>
          <p
            class="mt-5 text-base sm:text-lg text-secondary-content/75 leading-relaxed text-pretty sm:first-letter:float-left sm:first-letter:mr-3 sm:first-letter:mt-1 sm:first-letter:text-6xl sm:first-letter:leading-[0.8] sm:first-letter:font-semibold sm:first-letter:text-primary"
            set:html={conEnlaces(t.queEs)}
          />
        </section>

        <!-- Diagnóstico facial 3D (Método Deleic) -->
        {
          t.metodoDeleic && (
            <MetodoDeleic modo={t.metodoDeleic} num={num("diagnostico-3d")} />
          )
        }

        <!-- Modalidades -->
        {
          t.modalidades && t.modalidades.length > 0 && (
            <section
              id="modalidades"
              class="reveal scroll-mt-28 rounded-4xl bg-base-100 seccion-card ring-1 ring-black/5"
            >
              <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest">
                <span class="tabular-nums text-primary">
                  {num("modalidades")}
                </span>
                <span class="h-px w-8 bg-primary/30" aria-hidden="true" />
                <span class="text-secondary-content/65">{modalidadesEyebrow}</span>
              </div>
              <h2 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight">
                {t.modalidadesTitulo ?? "Modalidades"}
              </h2>
              <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                {t.modalidades.map((m) => (
                  <article class="flex flex-col rounded-3xl bg-base-200 p-6 md:only:col-span-2">
                    {m.etiqueta && (
                      <span class="mb-3 self-start rounded-full bg-primary px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-primary-content">
                        {m.etiqueta}
                      </span>
                    )}
                    <div class="flex items-start justify-between gap-4">
                      <h3 class="text-lg font-semibold text-secondary-content text-balance">
                        {m.titulo}
                      </h3>
                      {m.precio && (
                        <span class="shrink-0 rounded-full bg-base-100 px-3 py-1 text-base font-semibold tabular-nums text-primary ring-1 ring-black/5">
                          {m.precio}
                        </span>
                      )}
                    </div>
                    {m.subtitulo && (
                      <p class="mt-1.5 text-sm font-medium text-primary leading-snug text-pretty">
                        {m.subtitulo}
                      </p>
                    )}
                    <p
                      class="mt-2 text-secondary-content/70 leading-relaxed text-pretty"
                      set:html={conEnlaces(m.texto)}
                    />
                    {m.puntos && m.puntos.length > 0 && (
                      <div class="mt-4">
                        <p class="text-[11px] font-semibold uppercase tracking-widest text-secondary-content/65">
                          {m.puntosTitulo ?? "Qué podemos trabajar"}
                        </p>
                        <ul class="mt-3 space-y-2">
                          {m.puntos.map((p) => (
                            <li class="flex items-start gap-3 text-sm text-secondary-content/80 leading-relaxed">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="shrink-0 mt-0.5 w-4 h-4 text-primary"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2.2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                                set:html={icons.check}
                              />
                              <span>{p}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
