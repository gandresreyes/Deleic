---
// src/pages/facial-corporal/index.astro
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { idNegocio, migas } from "../../lib/schema";

const todos = await getCollection("facialCorporal");

// El diagnóstico va en su propia banda, no en el grid
const SLUG_DIAGNOSTICO = "diagnostico-facial-corporal";
const tratamientos = todos.filter((t) => t.data.slug !== SLUG_DIAGNOSTICO);

// El tratamiento marcado como destacado ocupa más espacio
const destacado = tratamientos.find((t) => t.data.destacadoEnNovedades);
const resto = tratamientos.filter((t) => t !== destacado);

const marcas = ["Eberlin", "Mesoestetic", "Kelaya", "Hitome"];

// Schema para buscadores e IAs: la lista de tratamientos, cada uno con su página
const site = Astro.site ?? Astro.url;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: "Tratamientos faciales y corporales en León",
      itemListElement: todos.map((t, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "Service",
          name: t.data.nombre,
          description: t.data.descripcionCorta,
          url: new URL(`/facial-corporal/${t.id}/`, site).href,
          provider: { "@id": idNegocio(site) },
        },
      })),
    },
    migas(site, [["Facial & Corporal", "/facial-corporal/"]]),
  ],
};
---

<Layout
  title="Tratamientos faciales y corporales en León | Deleic"
  description="Tratamientos faciales y corporales en León. Cosmética profesional y protocolos personalizados para cada tipo de piel."
>
  <!-- 1. HERO -->
  <section class="seccion">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-5 text-secondary-content"
    >
      <div class="group relative md:col-span-7 py-7 flex items-end">
        <div>
          <span
            class="text-sm font-semibold tracking-widest uppercase text-primary"
          >
            Facial & Corporal
          </span>
          <h1
            class="mt-3 text-4xl sm:text-5xl font-semibold leading-tight text-secondary-content"
          >
            Tu piel, tratada a tu medida
          </h1>
          <p class="mt-5 text-lg text-secondary-content/70 max-w-lg">
            Cosmética profesional y protocolos personalizados. Si no sabes cuál
            necesitas, empezamos con un diagnóstico gratuito.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={`/facial-corporal/${SLUG_DIAGNOSTICO}/`}
              class="btn btn-primary rounded-full px-7"
            >
              Diagnóstico gratuito
            </a>
            <a
              href="#tratamientos"
              class="btn btn-ghost rounded-full px-5 text-secondary-content"
            >
              Ver tratamientos <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </div>

      <!-- imagen -->
      <div class="group relative md:col-span-5 hidden md:block">
        <img
          src="/img/facialCorporal/hero.webp"
          class="w-full h-100 object-cover rounded-3xl"
          alt="Especialista de Deleic realizando un diagnóstico facial avanzado"
          transition:name="facial-corporal"
        />
      </div>
    </div>
  </section>

  <!-- 2. TRATAMIENTOS -->
  <section id="tratamientos" class="card bg-base-100 seccion-card scroll-mt-24">
    <div>
      <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          destacado && (
            <a
              href={`/facial-corporal/${destacado.data.slug}/`}
              class="group relative sm:col-span-2 min-h-[340px] rounded-3xl overflow-hidden bg-secondary-content flex items-end"
            >
              <img
                src={destacado.data.imagen}
                alt={destacado.data.imagenAlt}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/25 to-transparent" />

              <span class="absolute top-5 left-5 text-[11px] font-bold tracking-wider uppercase bg-base-100/15 backdrop-blur-sm text-base-100 px-3 py-1.5 rounded-full">
                Novedad
              </span>

              <div class="relative p-8 max-w-lg">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-base-100/70">
                  {destacado.data.categoria}
                </span>
                <h2 class="mt-1 text-3xl font-semibold text-base-100">
                  {destacado.data.nombre}
                </h2>
                <p class="mt-2 text-sm text-base-100/80 leading-relaxed">
                  {destacado.data.descripcionCorta}
                </p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-base-100">
                  Saber más
                  <span
                    class="group-hover:translate-x-1 transition-transform"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </span>
              </div>
            </a>
          )
        }

        {
          resto.map((t) => (
            <a
              href={`/facial-corporal/${t.data.slug}/`}
              class="group flex flex-col bg-base-100 rounded-3xl border border-base-300 overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300"
            >
              <div class="relative h-45 bg-base-300 overflow-hidden">
                <img
                  src={t.data.imagen}
                  alt={t.data.imagenAlt}
                  loading="lazy"
                  transition:name={t.data.id}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <span class="absolute top-4 left-4 text-[11px] font-semibold uppercase tracking-wide bg-base-100/90 backdrop-blur-sm text-primary px-3 py-1 rounded-full">
                  {t.data.categoria}
                </span>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-lg font-semibold text-secondary-content">
                  {t.data.nombre}
                </h3>
                <p class="mt-1.5 text-sm text-secondary-content/70 leading-snug">
                  {t.data.descripcionCorta}
                </p>
                <span
                  class="mt-5 ml-auto w-9 h-9 rounded-full bg-base-200 text-secondary-content flex items-center justify-center group-hover:bg-primary group-hover:text-primary-content transition-colors"
                  aria-hidden="true"
                >
                  →
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Puente a Medicina Estética -->
      <p class="mt-10 text-sm text-secondary-content/70">
        ¿Buscas rellenos, hilos tensores o mesoterapia?
        <a
          href="/medicina-estetica/"
          class="font-medium text-primary hover:underline"
        >
          Descubre Medicina Estética →
        </a>
      </p>
    </div>
  </section>

  <!-- 3. MARCAS -->
  <section class="seccion">
    <div
      class="flex flex-col md:flex-row md:items-center gap-6 md:gap-12"
    >
      <p
        class="text-sm font-semibold tracking-widest uppercase text-secondary-content/60 shrink-0"
      >
        Cosmética profesional
      </p>
      <ul class="reveal-stagger flex flex-wrap gap-3">
        {
          marcas.map((marca) => (
            <li class="rounded-full border border-base-300 bg-base-100 px-5 py-2 text-sm font-medium text-secondary-content">
              {marca}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
</Layout>
