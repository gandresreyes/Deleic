---
import Layout from "../layouts/Layout.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import Ubication from "../components/Ubication.astro";
import NewFeatures from "../components/NewFeatures.astro";
import metodo from "../data/metodoDeleic.json";
import { whatsapp } from "../data/contacto";
import { idNegocio, negocio } from "../lib/schema";

const icons = {
  check: '<path d="M5 12l5 5L20 7"/>',
  arrow: '<path d="M5 12h14m-5-5l5 5-5 5"/>',
  whatsapp:
    '<path d="M3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 8 19.3z"/><path d="M9 8.6c.2-.4.5-.6.9-.6h.5l1 2.2-.8 1a5.6 5.6 0 0 0 2.3 2.3l1-.8 2.2 1v.5c0 .4-.2.7-.6.9a3 3 0 0 1-2.6.2 7.7 7.7 0 0 1-4.1-4.1 3 3 0 0 1 .2-2.6z"/>',
  // Diagnóstico 3D (mismos trazos que /metodo-deleic/)
  droplet: '<path d="M12 3s6 6.2 6 10.5a6 6 0 01-12 0C6 9.2 12 3 12 3z"/>',
  spots:
    '<circle cx="12" cy="12" r="9"/><circle cx="9" cy="10" r="1"/><circle cx="14" cy="9" r="1"/><circle cx="14" cy="14" r="1"/><circle cx="9" cy="15" r="1"/>',
  waves:
    '<path d="M3 8c2.5-2 4.5-2 7 0s4.5 2 7 0 3-1 4-.5M3 14c2.5-2 4.5-2 7 0s4.5 2 7 0 3-1 4-.5"/>',
  pore: '<circle cx="12" cy="15" r="4"/><path d="M12 3v3M8 5l1 2M16 5l-1 2"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>',
  shield:
    '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 9l6 6"/>',
};

const confianza = [
  "Diagnóstico facial gratuito",
  "Láser de diodo ENEKA PRO",
  "En el centro de León",
];

// Schema.org del negocio: clave para búsquedas locales y respuestas de IA
const site = Astro.site ?? Astro.url;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      ...negocio(site),
      knowsAbout: [
        "Depilación láser",
        "Medicina estética",
        "Tratamientos faciales",
        "Tratamientos corporales",
        "Microblading",
        "Micropigmentación",
        "Diagnóstico facial 3D",
      ],
    },
    {
      "@type": "WebSite",
      name: "Deleic",
      url: new URL("/", site).href,
      inLanguage: "es-ES",
      publisher: { "@id": idNegocio(site) },
    },
  ],
};
---

<Layout
  title="Deleic | Medicina Estética y Depilación Láser en León"
  description="Centro de medicina estética, depilación láser y tratamientos faciales y corporales en León. Diagnóstico personalizado y resultados naturales. Reserva por WhatsApp."
>
  <div class="pila text-secondary-content">
    <!-- 1. HERO -->
      <!--
        Móvil/tablet: imagen arriba y texto debajo (sin superponerse).
        Escritorio: texto a la izquierda, imagen a la derecha.
        La cara está en el lado izquierdo de la foto: el encuadre la mantiene visible.
      -->
      <section
        class="relative isolate overflow-hidden rounded-4xl bg-secondary-content text-base-100 grid grid-cols-1 lg:grid-cols-2 lg:min-h-160"
      >
        <div aria-hidden="true" class="textura-cursor"></div>
        <div
          aria-hidden="true"
          class="absolute -left-24 -bottom-24 -z-10 h-80 w-80 rounded-full bg-primary/50 blur-3xl"
        >
        </div>

        <div class="relative h-64 sm:h-80 lg:order-2 lg:h-auto">
          <img
            src="/img/screen.webp"
            alt="Aplicación de sérum facial en un tratamiento de Deleic"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-[15%_center] sm:object-[center_30%] lg:object-[12%_center]"
          />
          <!-- Funde la foto con el fondo: hacia abajo en móvil, hacia la izquierda en escritorio -->
          <div
            aria-hidden="true"
            class="absolute inset-0 bg-linear-to-t from-secondary-content via-secondary-content/10 to-transparent lg:bg-linear-to-r lg:via-transparent"
          >
          </div>
        </div>

        <div
          class="relative -mt-10 flex flex-col justify-center px-6 pb-8 sm:-mt-12 sm:px-10 sm:pb-10 lg:mt-0 lg:p-14 xl:p-16"
        >
          <div class="max-w-xl">
            <span
              class="inline-flex items-center gap-2 rounded-full bg-base-100/10 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] ring-1 ring-base-100/20 backdrop-blur-sm"
            >
              <span
                class="h-1.5 w-1.5 rounded-full bg-base-100"
                aria-hidden="true"></span>
              Deleic · León
            </span>
            <h1
              class="mt-5 text-[2.1rem] leading-[1.1] sm:text-5xl xl:text-[3.5rem] font-semibold tracking-tight text-balance"
            >
              Centro de Medicina Estética y Depilación Láser en León
            </h1>
            <p
              class="mt-5 max-w-xl text-base sm:text-lg text-base-100/80 leading-relaxed text-pretty"
            >
              <strong class="font-semibold text-base-100">Deleic</strong>,
              precisión médica para tu mejor versión. Tratamientos
              personalizados a partir de un diagnóstico de tu piel.
            </p>

            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <a
                href={whatsapp()}
                target="_blank"
                rel="noopener"
                class="btn h-12 rounded-full border-0 bg-base-100 px-7 text-primary shadow-lg shadow-black/30 hover:bg-base-200"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icons.whatsapp}
                />
                Reservar por WhatsApp
              </a>
              <a
                href="#servicios"
                class="btn h-12 rounded-full border-base-100/30 bg-base-100/10 px-7 text-base-100 shadow-none backdrop-blur-md hover:border-base-100/50 hover:bg-base-100/20"
              >
                Ver tratamientos
              </a>
            </div>

            <ul
              class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-base-100/80"
            >
              {
                confianza.map((c) => (
                  <li class="flex items-center gap-2">
                    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-base-100/15">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-3 h-3"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        set:html={icons.check}
                      />
                    </span>
                    {c}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

    <!-- 2. MÉTODO DELEIC: novedad que el centro impulsa -->
      <section
        aria-labelledby="metodo-heading"
        class="reveal-scale relative isolate grid grid-cols-1 overflow-hidden rounded-4xl bg-base-100 ring-1 ring-black/5 lg:grid-cols-12"
      >
        <!-- Textura de puntos, la misma del resto del sitio -->
        <div
          aria-hidden="true"
          class="absolute inset-0 -z-10 opacity-[0.12] bg-[radial-gradient(rgb(0_0_0/0.6)_1px,transparent_1px)] bg-size-[18px_18px] mask-[linear-gradient(to_left,black,transparent_45%)]"
        >
        </div>

        <!-- Eclipse: la foto en un disco con una luz burdeos girando detrás -->
        <div
          class="relative isolate flex items-center justify-center overflow-hidden bg-secondary-content px-6 py-16 lg:col-span-5"
        >
          <div class="eclipse w-[min(78%,20rem)] lg:w-[min(76%,24rem)]">
            <div aria-hidden="true" class="eclipse-luz"></div>
            <div aria-hidden="true" class="grano -inset-[60%]"></div>
            <div class="eclipse-disco">
              <img
                src="/img/metodo-deleic/hero.webp"
                alt="Especialista de Deleic realizando un diagnóstico facial 3D"
                width="1600"
                height="1066"
                loading="lazy"
                class="object-[55%_center]"
                transition:name="metodo-deleic"
              />
            </div>
          </div>
          <span
            class="absolute left-4 top-4 rounded-full bg-primary px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-primary-content shadow-lg shadow-black/20"
          >
            Novedad
          </span>
        </div>

        <div class="p-6 sm:p-10 lg:col-span-7 lg:p-12">
          <span
            class="text-sm font-semibold uppercase tracking-widest text-primary"
          >
            Método Deleic
          </span>
          <h2
            id="metodo-heading"
            class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-balance"
          >
            Conoce tu piel al detalle con el diagnóstico facial 3D
          </h2>
          <p
            class="mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-secondary-content/70 text-pretty"
          >
            {metodo.queEs.antes}<strong
              class="font-semibold text-secondary-content"
              >{metodo.queEs.destacado}</strong
            >{metodo.queEs.despues}
          </p>

          <ul
            class="mt-6 flex flex-wrap gap-2"
            aria-label="Qué analiza el diagnóstico"
          >
            {
              metodo.analiza.items.map((item) => (
                <li class="inline-flex items-center gap-2 rounded-full bg-base-200 px-3 py-1.5 text-sm font-medium">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={icons[item.icono as keyof typeof icons]}
                  />
                  {item.titulo}
                </li>
              ))
            }
          </ul>

          <div
            class="mt-8 flex flex-col gap-6 border-t border-base-300 pt-6 sm:flex-row sm:items-center sm:justify-between"
          >
            <div class="flex items-center gap-4">
              <span
                class="text-4xl font-semibold tracking-tight tabular-nums text-primary"
              >
                {metodo.precio.visible}
              </span>
              <p
                class="max-w-56 text-sm leading-snug text-secondary-content/70"
              >
                Se descuentan íntegramente si comienzas un{" "}
                <strong class="font-semibold text-secondary-content"
                  >Plan Deleic</strong
                >.
              </p>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:shrink-0">
              <a
                href={whatsapp(metodo.oferta.cta.mensaje)}
                target="_blank"
                rel="noopener"
                class="btn btn-primary h-12 rounded-full border-0 px-6"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icons.whatsapp}
                />
                Reservar
              </a>
              <a
                href="/metodo-deleic/"
                class="btn h-12 rounded-full border-base-300 bg-base-100 px-6 text-secondary-content shadow-none hover:bg-base-200"
              >
                Conocer el método
              </a>
            </div>
          </div>
        </div>
      </section>

    <!-- 3. SERVICIOS -->
    <ServicesGrid />

    <!-- 4. NOVEDADES -->
    <NewFeatures />

    <!-- 6. UBICACIÓN -->
    <Ubication />
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
</Layout>
