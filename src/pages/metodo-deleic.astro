---
// src/pages/metodo-deleic.astro
import Layout from "../layouts/Layout.astro";
import { whatsapp } from "../data/contacto";
import Oferta from "../components/Metodo/Oferta.astro";
import Ubication from "../components/Ubication.astro";

// Un solo sitio para el precio: hero, oferta, FAQ y schema lo leen de aquí
const PRECIO = 29;

const diagnostico = [
  {
    icono: "droplet",
    titulo: "Hidratación",
    texto: "Medimos el nivel de hidratación de tu piel.",
  },
  {
    icono: "spots",
    titulo: "Manchas",
    texto:
      "Detectamos manchas solares, pigmentarias y marcas postinflamatorias.",
  },
  {
    icono: "waves",
    titulo: "Arrugas",
    texto: "Evaluamos líneas de expresión y arrugas en profundidad.",
  },
  {
    icono: "pore",
    titulo: "Poros y sebo",
    texto: "Analizamos el tamaño de poro y la producción de sebo.",
  },
  {
    icono: "layers",
    titulo: "Textura y tono",
    texto: "Estudiamos la textura, el tono y la uniformidad de tu piel.",
  },
  {
    icono: "shield",
    titulo: "Sensibilidad",
    texto: "Valoramos el nivel de sensibilidad y reactividad.",
  },
];

const porQue = [
  {
    icono: "target",
    titulo: "Diagnóstico preciso y objetivo",
    texto: "Tecnología 3D para conocer tu piel al detalle.",
  },
  {
    icono: "clipboard",
    titulo: "Plan personalizado para tu piel",
    texto: "Tratamientos adaptados a tus necesidades reales.",
  },
  {
    icono: "trend",
    titulo: "Resultados visibles y progresivos",
    texto: "Planes pensados para mejorar tu piel de forma progresiva.",
  },
];

const faq = [
  {
    pregunta: "¿Qué es el diagnóstico facial 3D?",
    respuesta:
      "Es un análisis avanzado que estudia tu piel en profundidad y detecta lo que no se ve a simple vista, para crear un plan de tratamiento 100% personalizado.",
  },
  {
    pregunta: "¿Qué analiza el diagnóstico?",
    respuesta:
      "Hidratación, manchas (solares, pigmentarias y marcas postinflamatorias), líneas de expresión y arrugas, tamaño de poro y producción de sebo, textura y tono, y nivel de sensibilidad y reactividad.",
  },
  {
    pregunta: "¿Cuánto cuesta?",
    respuesta: `El diagnóstico facial 3D cuesta ${PRECIO} €. Si después comienzas un Plan Deleic, esos ${PRECIO} € se descuentan íntegramente.`,
  },
];

// Iconos (trazo, 24x24). Heredan el color con currentColor
const icons: Record<string, string> = {
  droplet: '<path d="M12 3s6 6.2 6 10.5a6 6 0 01-12 0C6 9.2 12 3 12 3z"/>',
  spots:
    '<circle cx="12" cy="12" r="9"/><circle cx="9" cy="10" r="1"/><circle cx="14" cy="9" r="1"/><circle cx="14" cy="14" r="1"/><circle cx="9" cy="15" r="1"/>',
  waves:
    '<path d="M3 8c2.5-2 4.5-2 7 0s4.5 2 7 0 3-1 4-.5M3 14c2.5-2 4.5-2 7 0s4.5 2 7 0 3-1 4-.5"/>',
  pore: '<circle cx="12" cy="15" r="4"/><path d="M12 3v3M8 5l1 2M16 5l-1 2"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>',
  shield:
    '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 9l6 6"/>',
  target:
    '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
  clipboard:
    '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v2H9zM9 13l2 2 4-4"/>',
  trend: '<path d="M3 17l6-6 4 4 8-8M15 7h6v6"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M5 12v8a1 1 0 001 1h12a1 1 0 001-1v-8M8 8a2.5 2.5 0 110-5c2 0 4 2.5 4 5 0-2.5 2-5 4-5a2.5 2.5 0 110 5"/>',
  sparkles:
    '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>',
};

const descripcion =
  "Diagnóstico facial 3D que analiza hidratación, manchas, arrugas, poros, textura y sensibilidad para crear tu plan de tratamiento personalizado.";

// Schema: Service con la oferta + FAQPage
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Diagnóstico facial 3D · Método Deleic",
      serviceType: "Diagnóstico facial",
      description: descripcion,
      areaServed: "León",
      provider: {
        "@type": "HealthAndBeautyBusiness",
        name: "Deleic",
        telephone: "+34987027906",
        address: {
          "@type": "PostalAddress",
          streetAddress: "Calle Roa de la Vega 18, bajo",
          postalCode: "24001",
          addressLocality: "León",
          addressCountry: "ES",
        },
      },
      offers: { "@type": "Offer", price: String(PRECIO), priceCurrency: "EUR" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.pregunta,
        acceptedAnswer: { "@type": "Answer", text: f.respuesta },
      })),
    },
  ],
};
---

<Layout
  title="Método Deleic: diagnóstico facial 3D en León"
  description={descripcion}
>
  <!-- Hero -->
  <section class="seccion">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-5 text-secondary-content"
    >
      <div class="group relative md:col-span-7 py-7 flex items-end">
        <div>
          <span
            class="text-sm font-semibold tracking-widest uppercase text-primary"
          >
            El momento perfecto para cuidar tu piel
          </span>
          <h3 class="mt-3 text-3xl sm:text-4xl font-semibold">Método Deleic</h3>
          <p class="mt-4 text-base-content/70 text-lg">
            Ciencia, tecnología y personalización para la piel que quieres.
          </p>

          <div
            class="mt-8 flex gap-3 font-bold flex-wrap justify-center sm:justify-start"
          >
            <a
              href={whatsapp(
                "Hola, me gustaría reservar el diagnóstico facial 3D del Método Deleic.",
              )}
              target="_blank"
              rel="noopener"
              class="px-3 sm:px-6 py-3 sm:py-4 bg-primary text-primary-content rounded-full"
            >
              Reservar diagnóstico
            </a>
            <a
              href="#que-diagnosticamos"
              class="px-3 sm:px-6 py-3 sm:py-4 bg-base-100 text-secondary-content rounded-full border border-base-300"
            >
              Qué analizamos
            </a>
          </div>

          <div class="flex justify-start md:gap-6 mt-12 text-[12px] md:text-md">
            <div class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.target}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Diagnóstico <br /> facial 3D
              </p>
            </div>
            <div class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.clipboard}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Plan <br /> personalizado
              </p>
            </div>
            <div class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.gift}
              />
              <p class="text-base-content/70 leading-none uppercase">
                {PRECIO}€ menos <br class="hidden md:block" /> en tu plan
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="group relative md:col-span-5 hidden md:block">
        <img
          src="/img/metodo-deleic/hero.webp"
          class="w-full h-100 object-cover rounded-3xl"
          alt="Equipo de diagnóstico facial 3D del Método Deleic"
          transition:name="metodo-deleic"
        />
      </div>
    </div>
  </section>

  <!-- Qué es + qué diagnosticamos -->
  <section id="que-diagnosticamos" class="card bg-base-100 seccion-card scroll-mt-24">
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        ¿Qué es el Método Deleic?
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        Conoce tu piel al detalle
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">
        Un diagnóstico facial 3D avanzado que analiza tu piel en profundidad
        para detectar lo que no se ve a simple vista y crear un plan de
        tratamiento 100% personalizado para ti.
      </p>
    </div>

    <div class="mt-10">
      <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          diagnostico.map((item) => (
            <div>
              <div class="flex gap-1 mb-2 items-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-8 h-8  text-primary"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[item.icono]}
                />
                <h3 class="text-md font-semibold text-secondary-content mb-1">
                  {item.titulo}
                </h3>
              </div>
              <p class="text-sm text-base-content/70 leading-relaxed">
                {item.texto}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex items-center gap-4 rounded-2xl bg-base-200 p-6">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-8 h-8 shrink-0 text-primary"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={icons.sparkles}
      />
      <p class="font-semibold text-secondary-content">
        Con esta información, creamos tu plan de tratamiento personalizado.
      </p>
    </div>
  </section>

  <!-- Oferta -->
  <Oferta precio={PRECIO} />

  <!-- Por qué elegirlo -->
  <section class="card bg-base-100 seccion-card">
    <span
      class="reveal block text-sm font-semibold tracking-widest uppercase text-primary"
    >
      ¿Por qué elegir el Método Deleic?
    </span>

    <div class="reveal-stagger mt-8 grid grid-cols-1 sm:grid-cols-3 gap-8">
      {
        porQue.map((item) => (
          <div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-8 h-8 mb-4 text-primary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={icons[item.icono]}
            />
            <p class="text-sm font-semibold text-secondary-content mb-1">
              {item.titulo}
            </p>
            <p class="text-sm text-base-content/70 leading-relaxed">
              {item.texto}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="card bg-base-100 seccion-card">
    <span
      class="reveal block text-sm font-semibold tracking-widest uppercase text-primary"
    >
      Preguntas frecuentes
    </span>
    <h2
      class="reveal mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
    >
      Resolvemos tus dudas
    </h2>

    <div class="reveal-stagger mt-8 divide-y divide-base-300 border-y border-base-300">
      {
        faq.map((f) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-medium text-secondary-content">
              {f.pregunta}
              <span
                class="text-primary text-xl leading-none group-open:rotate-45 transition-transform"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-base-content/70 leading-relaxed">
              {f.respuesta}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Ubicación -->
  <Ubication />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
