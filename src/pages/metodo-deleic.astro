---
// src/pages/metodo-deleic.astro
// Contenido de las infografías del centro (diagnóstico facial avanzado).
// Todo sale de src/data/metodoDeleic.json; el precio, de metodo.precio.
import Layout from "../layouts/Layout.astro";
import { whatsapp } from "../data/contacto";
import metodo from "../data/metodoDeleic.json";
import { faqPage, migas, negocio } from "../lib/schema";
import Oferta from "../components/Metodo/Oferta.astro";
import Ubication from "../components/Ubication.astro";

const { seo, hero, queEs, espectros, areas, resultados, faq } = metodo;

// "{precio}" en los textos del JSON → "29 €"
const precio = `${metodo.precio.valor} €`;
const conPrecio = (s: string) => s.replaceAll("{precio}", precio);

const description = conPrecio(seo.description);
const preguntas = faq.items.map((f) => ({ ...f, respuesta: conPrecio(f.respuesta) }));

// Nivel de la escala → fondo cada vez más intenso
const tonosNivel = [
  "bg-primary/10 text-primary",
  "bg-primary/25 text-primary",
  "bg-primary/45 text-primary-content",
  "bg-primary/70 text-primary-content",
  "bg-primary text-primary-content",
];

// Iconos (trazo, 24x24). Heredan el color con currentColor
const icons: Record<string, string> = {
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M5 12v8a1 1 0 001 1h12a1 1 0 001-1v-8M8 8a2.5 2.5 0 110-5c2 0 4 2.5 4 5 0-2.5 2-5 4-5a2.5 2.5 0 110 5"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>',
  droplet: '<path d="M12 3s6 6.2 6 10.5a6 6 0 01-12 0C6 9.2 12 3 12 3z"/>',
  spots:
    '<circle cx="12" cy="12" r="9"/><circle cx="9" cy="10" r="1"/><circle cx="14" cy="9" r="1"/><circle cx="14" cy="14" r="1"/><circle cx="9" cy="15" r="1"/>',
  pore: '<circle cx="12" cy="15" r="4"/><path d="M12 3v3M8 5l1 2M16 5l-1 2"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>',
  shield:
    '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 9l6 6"/>',
};

// Schema: Service con la oferta + FAQPage + migas
const site = Astro.site ?? Astro.url;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Diagnóstico facial avanzado · Método Deleic",
      serviceType: "Diagnóstico facial",
      description,
      areaServed: "León",
      url: new URL("/metodo-deleic/", site).href,
      provider: negocio(site),
      offers: {
        "@type": "Offer",
        price: metodo.precio.valor,
        priceCurrency: metodo.precio.moneda,
      },
    },
    faqPage(preguntas),
    migas(site, [["Método Deleic", "/metodo-deleic/"]]),
  ],
};
---

<Layout
  title={seo.title}
  description={description}
  image={hero.imagen}
  imageAlt={hero.imagenAlt}
>
  <!-- Hero -->
  <section class="seccion">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-5 text-secondary-content"
    >
      <div class="group relative md:col-span-7 py-7 flex items-end">
        <div>
          <span
            class="text-sm font-semibold tracking-widest uppercase text-primary"
          >
            {hero.eyebrow}
          </span>
          <h1 class="mt-3 text-4xl sm:text-5xl font-semibold text-balance">
            {hero.titulo}
          </h1>
          <p class="mt-4 text-base-content/70 text-lg">{hero.subtitulo}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={whatsapp(hero.ctaPrincipal.mensaje)}
              target="_blank"
              rel="noopener"
              class="px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-primary text-primary-content font-bold"
            >
              {hero.ctaPrincipal.texto}
            </a>
            <a
              href={hero.ctaSecundario.href}
              class="px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-base-100 text-secondary-content border border-base-300 font-bold"
            >
              {hero.ctaSecundario.texto}
            </a>
          </div>

          <ul
            class="flex justify-start gap-2 md:gap-6 mt-12 text-[12px] md:text-sm"
          >
            {
              hero.puntos.map((p) => (
                <li class="flex gap-2 items-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-8 h-8 shrink-0 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={icons[p.icono]}
                  />
                  <p class="text-base-content/70 leading-none uppercase">
                    {conPrecio(p.texto[0])} <br /> {p.texto[1]}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="group relative md:col-span-5 hidden md:block">
        <img
          src={hero.imagen}
          width="1600"
          height="1066"
          class="w-full h-100 object-cover rounded-3xl"
          alt={hero.imagenAlt}
          fetchpriority="high"
          transition:name="metodo-deleic"
        />
      </div>
    </div>
  </section>

  <!-- Qué es -->
  <section
    class="card bg-base-100 seccion-card text-secondary-content"
    aria-labelledby="que-es-heading"
  >
    <div class="reveal">
      <span class="text-sm font-semibold tracking-widest uppercase text-primary">
        {queEs.eyebrow}
      </span>
      <h2 id="que-es-heading" class="mt-3 text-3xl sm:text-4xl font-semibold">
        {queEs.titulo}
      </h2>
      <p class="mt-4 max-w-3xl text-lg text-base-content/70 text-pretty">
        {queEs.antes}<strong class="font-semibold text-secondary-content"
          >{queEs.destacado}</strong
        >{queEs.despues}
      </p>
    </div>

    <div class="mt-10 flex items-start gap-4 rounded-2xl bg-base-200 p-6">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-8 h-8 shrink-0 text-primary"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={icons.search}
      />
      <div>
        <h3 class="font-semibold">{queEs.porQue.titulo}</h3>
        <p class="mt-1 text-base-content/70">{queEs.porQue.texto}</p>
      </div>
    </div>
  </section>

  <!-- Los 8 espectros -->
  <section
    class="card bg-base-100 seccion-card text-secondary-content"
    aria-labelledby="espectros-heading"
  >
    <div class="reveal">
      <span class="text-sm font-semibold tracking-widest uppercase text-primary">
        {espectros.eyebrow}
      </span>
      <h2
        id="espectros-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold"
      >
        {espectros.titulo}
      </h2>
      <p class="mt-4 max-w-3xl text-lg text-base-content/70 text-pretty">
        {espectros.texto}
      </p>
    </div>

    <ol
      class="reveal-stagger mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5"
    >
      {
        espectros.items.map((e, i) => (
          <li class="flex flex-col rounded-3xl bg-base-200 p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-content">
              {i + 1}
            </span>
            <h3 class="mt-4 text-lg font-semibold leading-tight">
              {e.nombre}
              {e.detalle && (
                <span class="block text-sm font-medium text-primary">
                  {e.detalle}
                </span>
              )}
            </h3>
            <p class="mt-2 text-sm text-base-content/70 leading-relaxed">
              {e.texto}
            </p>
            <ul
              class="mt-auto pt-4 space-y-1 text-sm"
              aria-label={`Qué detecta: ${e.nombre}`}
            >
              {e.detecta.map((d) => (
                <li class="flex gap-2">
                  <span
                    aria-hidden="true"
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"
                  />
                  {d}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Las 5 áreas -->
  <section
    id="que-analizamos"
    class="seccion scroll-mt-24 text-secondary-content"
    aria-labelledby="areas-heading"
  >
    <div class="reveal">
      <span class="text-sm font-semibold tracking-widest uppercase text-primary">
        {areas.eyebrow}
      </span>
      <h2 id="areas-heading" class="mt-3 text-3xl sm:text-4xl font-semibold">
        {areas.titulo}
      </h2>
    </div>

    <ul
      class="reveal-stagger mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 sm:gap-5"
    >
      {
        areas.items.map((a) => (
          <li class="rounded-3xl border border-base-300 bg-base-100 p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[a.icono]}
              />
            </span>
            <h3 class="mt-4 font-semibold">{a.titulo}</h3>
            <ul class="mt-3 space-y-1 text-sm text-base-content/70">
              {a.puntos.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

  </section>

  <!-- Cómo leemos los resultados -->
  <section
    class="card bg-base-100 seccion-card text-secondary-content"
    aria-labelledby="resultados-heading"
  >
    <div class="reveal">
      <span class="text-sm font-semibold tracking-widest uppercase text-primary">
        {resultados.eyebrow}
      </span>
      <h2
        id="resultados-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold"
      >
        {resultados.titulo}
      </h2>
    </div>

    <div
      class="reveal-stagger mt-10 grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-5"
    >
      <!-- Escala I–V -->
      <div class="rounded-3xl bg-base-200 p-6">
        <h3 class="font-semibold">{resultados.escala.titulo}</h3>
        <ol class="mt-4 space-y-2">
          {
            resultados.escala.niveles.map((n, i) => (
              <li class="flex items-center gap-3 text-sm">
                <span
                  class:list={[
                    "flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold",
                    tonosNivel[i],
                  ]}
                >
                  {n.nivel}
                </span>
                <span class="w-16 shrink-0 tabular-nums text-base-content/70">
                  {n.rango}
                </span>
                <span class="font-medium">{n.significado}</span>
              </li>
            ))
          }
        </ol>
        <p class="mt-4 text-xs text-base-content/60">
          {resultados.escala.nota}
        </p>
      </div>

      <!-- Hidratación -->
      <div class="rounded-3xl bg-base-200 p-6">
        <h3 class="font-semibold">{resultados.hidratacion.titulo}</h3>
        <p class="mt-1 text-sm text-base-content/70">
          {resultados.hidratacion.texto}
        </p>
        <dl class="mt-5 grid grid-cols-2 gap-3 text-center">
          <div class="rounded-2xl bg-success/10 p-4 text-success">
            <dt class="text-2xl font-semibold tabular-nums">
              {resultados.hidratacion.normal.valor}
            </dt>
            <dd class="mt-1 text-xs font-medium">
              {resultados.hidratacion.normal.texto}
            </dd>
          </div>
          <div class="rounded-2xl bg-primary/10 p-4 text-primary">
            <dt class="text-2xl font-semibold tabular-nums">
              {resultados.hidratacion.deficit.valor}
            </dt>
            <dd class="mt-1 text-xs font-medium">
              {resultados.hidratacion.deficit.texto}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Tipos de piel (Baumann) -->
      <div class="rounded-3xl bg-base-200 p-6">
        <h3 class="font-semibold">{resultados.baumann.titulo}</h3>
        <ul class="mt-5 space-y-4 text-sm">
          {
            resultados.baumann.ejes.map(([a, b]) => (
              <li class="grid grid-cols-[6.5rem_1fr_6.5rem] items-center gap-2">
                <span class="font-medium">{a}</span>
                <span aria-hidden="true" class="relative h-px bg-base-content/20">
                  <span class="absolute left-1/2 top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary" />
                </span>
                <span class="text-right font-medium">{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Oferta, proceso y lema -->
  <Oferta />

  <!-- Preguntas frecuentes -->
  <section
    class="card bg-base-100 seccion-card text-secondary-content"
    aria-labelledby="faq-heading"
  >
    <span
      class="reveal block text-sm font-semibold tracking-widest uppercase text-primary"
    >
      {faq.eyebrow}
    </span>
    <h2
      id="faq-heading"
      class="reveal mt-3 text-3xl sm:text-4xl font-semibold"
    >
      {faq.titulo}
    </h2>

    <div class="mt-8 divide-y divide-base-300 border-y border-base-300">
      {
        preguntas.map((f) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-medium [&::-webkit-details-marker]:hidden">
              {f.pregunta}
              <span
                class="text-primary text-xl leading-none group-open:rotate-45 transition-transform"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-base-content/70 leading-relaxed">
              {f.respuesta}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Ubicación -->
  <Ubication />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
</Layout>
