---
// src/pages/metodo-deleic.astro
// Contenido de las infografías del centro (diagnóstico facial avanzado).
// Todo sale de src/data/metodoDeleic.json; el precio, de metodo.precio.
import Layout from "../layouts/Layout.astro";
import Foto from "../components/Foto.astro";
import { sizesCubre, TRAMOS_HERO } from "../lib/imagenes";
import { whatsapp } from "../data/contacto";
import metodo from "../data/metodoDeleic.json";
import marcas from "../data/escanerMarcas.json";
import { faqPage, migas, negocio, zonaServida } from "../lib/schema";
import Oferta from "../components/Metodo/Oferta.astro";
import Ubication from "../components/Ubication.astro";

const { seo, hero, queEs, espectros, areas, resultados, faq } = metodo;

// "{precio}" en los textos del JSON → "29 €"
const precio = `${metodo.precio.valor} €`;
const conPrecio = (s: string) => s.replaceAll("{precio}", precio);

const description = conPrecio(seo.description);
const preguntas = faq.items.map((f) => ({ ...f, respuesta: conPrecio(f.respuesta) }));

// Rótulo de cada luz en el visor del escáner: "Luz azul · 405 nm"
const etiquetaLuz = (e: { nombre: string; detalle: string }) =>
  [e.nombre, e.detalle].filter(Boolean).join(" · ");

// Capa de análisis de cada luz (la genera scripts/escaner-luces.mjs)
type Analisis = {
  formas: { d: string; clase: string; o?: number }[];
  textos: { x: number; y: number; ancla: string; lineas: string[] }[];
};
const analisis = marcas.luces as Record<string, Analisis>;

// Nivel de la escala → fondo cada vez más intenso
const tonosNivel = [
  "bg-primary/10 text-primary",
  "bg-primary/25 text-primary",
  "bg-primary/45 text-primary-content",
  "bg-primary/70 text-primary-content",
  "bg-primary text-primary-content",
];

// Iconos (trazo, 24x24). Heredan el color con currentColor
const icons: Record<string, string> = {
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M5 12v8a1 1 0 001 1h12a1 1 0 001-1v-8M8 8a2.5 2.5 0 110-5c2 0 4 2.5 4 5 0-2.5 2-5 4-5a2.5 2.5 0 110 5"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>',
  droplet: '<path d="M12 3s6 6.2 6 10.5a6 6 0 01-12 0C6 9.2 12 3 12 3z"/>',
  spots:
    '<circle cx="12" cy="12" r="9"/><circle cx="9" cy="10" r="1"/><circle cx="14" cy="9" r="1"/><circle cx="14" cy="14" r="1"/><circle cx="9" cy="15" r="1"/>',
  pore: '<circle cx="12" cy="15" r="4"/><path d="M12 3v3M8 5l1 2M16 5l-1 2"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>',
  shield:
    '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 9l6 6"/>',
};

// Schema: Service con la oferta + FAQPage + migas
const site = Astro.site ?? Astro.url;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Diagnóstico facial avanzado · Método Deleic",
      serviceType: "Diagnóstico facial",
      description,
      areaServed: zonaServida,
      url: new URL("/metodo-deleic/", site).href,
      provider: negocio(site),
      offers: {
        "@type": "Offer",
        price: metodo.precio.valor,
        priceCurrency: metodo.precio.moneda,
      },
    },
    faqPage(preguntas),
    migas(site, [["Método Deleic", "/metodo-deleic/"]]),
  ],
};
---

<Layout
  title={seo.title}
  description={description}
  image={hero.imagen}
  imageAlt={hero.imagenAlt}
>
  <!-- Hero -->
  <section class="seccion">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-5 text-secondary-content"
    >
      <div class="group relative md:col-span-7 py-7 flex items-end">
        <div>
          <span
            class="text-sm font-semibold tracking-widest uppercase text-primary"
          >
            {hero.eyebrow}
          </span>
          <h1 class="mt-3 text-4xl sm:text-5xl font-semibold text-balance">
            {hero.titulo}
          </h1>
          <p class="mt-4 text-base-content/70 text-lg">{hero.subtitulo}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={whatsapp(hero.ctaPrincipal.mensaje)}
              target="_blank"
              rel="noopener"
              class="px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-primary text-primary-content font-bold"
            >
              {hero.ctaPrincipal.texto}
            </a>
            <a
              href={hero.ctaSecundario.href}
              class="px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-base-100 text-secondary-content border border-base-300 font-bold"
            >
              {hero.ctaSecundario.texto}
            </a>
          </div>

          <ul
            class="flex justify-start gap-2 md:gap-6 mt-12 text-[12px] md:text-sm"
          >
            {
              hero.puntos.map((p) => (
                <li class="flex gap-2 items-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-8 h-8 shrink-0 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={icons[p.icono]}
                  />
                  <p class="text-base-content/70 leading-none uppercase">
                    {conPrecio(p.texto[0])} <br /> {p.texto[1]}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- En móvil la foto va arriba (antes no se veía) -->
      <div class="group relative md:col-span-5 order-first md:order-0">
        <Foto
          src={hero.imagen}
          sizes={sizesCubre(hero.imagen, [
            // Aquí la foto también se ve en móvil: 224px de alto (288 desde sm)
            ...TRAMOS_HERO.slice(0, -1),
            ["(min-width: 640px)", "100vw", 2.05],
            ["", "100vw", 1.46],
          ])}
          class="w-full h-56 sm:h-72 md:h-100 object-cover rounded-3xl"
          alt={hero.imagenAlt}
          fetchpriority="high"
          transition:name="metodo-deleic"
        />
      </div>
    </div>
  </section>

  <!-- Qué es -->
  <section
    class="card bg-base-100 seccion-card text-secondary-content"
    aria-labelledby="que-es-heading"
  >
    <!-- Sin foto: la cara la enseña el escáner de la sección siguiente.
         Desde lg, el "por qué" ocupa la columna derecha -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 lg:items-end">
      <div class="reveal lg:col-span-7">
        <span
          class="text-sm font-semibold tracking-widest uppercase text-primary"
        >
          {queEs.eyebrow}
        </span>
        <h2
          id="que-es-heading"
          class="mt-3 text-3xl sm:text-4xl font-semibold"
        >
          {queEs.titulo}
        </h2>
        <p class="mt-4 max-w-3xl text-lg text-base-content/70 text-pretty">
          {queEs.antes}<strong class="font-semibold text-secondary-content"
            >{queEs.destacado}</strong
          >{queEs.despues}
        </p>
      </div>

      <div
        class="lg:col-span-5 flex items-start gap-4 rounded-3xl bg-base-200 p-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-8 h-8 shrink-0 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icons.search}
        />
        <div>
          <h3 class="font-semibold">{queEs.porQue.titulo}</h3>
          <p class="mt-1 text-base-content/70">{queEs.porQue.texto}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Los 8 espectros -->
  <section
    class="card bg-base-100 seccion-card text-secondary-content"
    aria-labelledby="espectros-heading"
    data-escaner
  >
    <div class="reveal">
      <span class="text-sm font-semibold tracking-widest uppercase text-primary">
        {espectros.eyebrow}
      </span>
      <h2
        id="espectros-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold"
      >
        {espectros.titulo}
      </h2>
      <p class="mt-4 max-w-3xl text-lg text-base-content/70 text-pretty">
        {espectros.texto}
      </p>
    </div>

    <!-- Escáner: al bajar, cada tarjeta barre la cara del visor con su luz
         (global.css, "Escáner de luces", y scripts/escaner.ts). En móvil el
         visor va fijo arriba y la lista debajo; desde md, el visor va fijo a
         la izquierda, con las 8 luces en miniatura, y la lista a la derecha -->
    <div
      class="mt-6 md:mt-10 md:grid md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:items-start md:gap-10 lg:gap-14"
    >
      <div
        data-escaner-fijo
        class="sticky top-16 z-10 -mx-6 bg-base-100 px-6 pt-2 pb-4 md:top-28 md:mx-0 md:bg-transparent md:px-0 md:pt-0 md:pb-0"
      >
        <div class="reveal-scale">
          <!-- Decorativo: el contenido está en la lista -->
          <div
            aria-hidden="true"
            data-escaner-visor
            data-luz={espectros.items[0].luz}
            class="escaner-visor relative isolate max-h-[36svh] w-full overflow-hidden rounded-3xl bg-secondary-content md:max-h-[calc(100svh-15rem)]"
            style={`aspect-ratio: ${marcas.ancho} / ${marcas.alto}`}
          >
            {
              espectros.items.map((e, i) => (
                <div
                  data-escaner-luz
                  data-luz={e.luz}
                  class:list={["escaner-luz", i === 0 && "en-uso"]}
                  style={`--k: ${i}`}
                >
                  <div class="escaner-capa">
                    <div class="escaner-foto">
                      <img
                        src={`/img/metodo-deleic/escaner/${e.luz}.webp`}
                        alt=""
                        width={marcas.ancho}
                        height={marcas.alto}
                        loading="lazy"
                        decoding="async"
                      />
                      <svg
                        class="escaner-analisis"
                        viewBox={`0 0 ${marcas.ancho} ${marcas.alto}`}
                        preserveAspectRatio="xMidYMid slice"
                        style={`--tam: ${marcas.tamTexto}px`}
                      >
                        {analisis[e.luz]?.formas.map((f, j) => (
                          <path
                            d={f.d}
                            pathLength="1"
                            class={f.clase}
                            style={`--j: ${j}${f.o ? `; --o: ${f.o}` : ""}`}
                          />
                        ))}
                        {analisis[e.luz]?.textos.map((t) => (
                          <text text-anchor={t.ancla} dominant-baseline="middle">
                            {t.lineas.map((linea, k) => (
                              <tspan x={t.x} y={t.y + k * marcas.altoLinea}>
                                {linea}
                              </tspan>
                            ))}
                          </text>
                        ))}
                      </svg>
                    </div>
                  </div>
                  {i > 0 && <span class="escaner-linea" />}
                </div>
              ))
            }
            <!-- Linterna (con ratón): la piel con luz natural dentro de un
                 círculo que sigue al cursor, para comparar -->
            <div class="escaner-linterna">
              <img
                src="/img/metodo-deleic/escaner/blanca.webp"
                alt=""
                width={marcas.ancho}
                height={marcas.alto}
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="escaner-linterna-aro">
              <span
                class="absolute top-full left-1/2 mt-2 -translate-x-1/2 whitespace-nowrap text-[11px] font-semibold uppercase tracking-widest text-white [text-shadow:0_1px_3px_rgb(0_0_0/0.8)]"
              >
                Luz natural
              </span>
            </span>
            <span class="escaner-marco"></span>
            <!-- Las luces se calculan sobre una foto de muestra: no es una captura del equipo -->
            <span
              class="absolute left-7 top-5 text-[10px] font-semibold uppercase tracking-widest text-white/60 md:left-8 md:top-6 md:text-xs"
            >
              Simulación
            </span>
            <!-- Nombre de la luz sin fondo, para no tapar la imagen -->
            <div
              class="absolute inset-x-7 bottom-5 flex items-center justify-between gap-3 text-xs font-semibold uppercase tracking-wider text-base-100 [text-shadow:0_1px_3px_rgb(0_0_0/0.8)] md:inset-x-8 md:bottom-6 md:text-sm"
            >
              <span data-escaner-etiqueta>
                {etiquetaLuz(espectros.items[0])}
              </span>
              <span class="tabular-nums text-white/70">
                <span data-escaner-contador>1</span>/{espectros.items.length}
              </span>
            </div>
          </div>
        </div>

        <!-- Desde md: las 8 luces en miniatura; cada una lleva a su tarjeta -->
        <nav aria-label="Ir a cada luz" class="mt-4 hidden grid-cols-8 gap-2 md:grid">
          {
            espectros.items.map((e, i) => (
              <a
                href={`#luz-${e.luz}`}
                data-escaner-ir
                aria-label={etiquetaLuz(e)}
                aria-current={i === 0 ? "true" : undefined}
                class:list={["escaner-mini", i === 0 && "activa"]}
              >
                <img
                  src={`/img/metodo-deleic/escaner/${e.luz}.webp`}
                  alt=""
                  width={marcas.ancho}
                  height={marcas.alto}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))
          }
        </nav>

        <!-- Móvil: las tarjetas se funden al pasar bajo el visor -->
        <div
          class="pointer-events-none absolute inset-x-0 top-full h-6 bg-linear-to-b from-base-100 to-transparent md:hidden"
        >
        </div>
      </div>

      <!-- Desde md, aire bajo la última tarjeta para que llegue a barrer su
           luz mientras el visor sigue fijo. Lo calcula scripts/escaner.ts
           según la altura del visor (--aire) -->
      <ol
        data-escaner-lista
        class="reveal-stagger mt-2 grid grid-cols-1 gap-4 md:mt-0 md:gap-5 md:pb-(--aire)"
      >
        {
          espectros.items.map((e, i) => (
            <li
              id={`luz-${e.luz}`}
              data-escaner-tarjeta
              data-etiqueta={etiquetaLuz(e)}
              class="flex scroll-mt-28 flex-col rounded-3xl bg-base-200 p-6"
            >
              <span class="escaner-num flex h-9 w-9 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-content">
                {i + 1}
              </span>
              <h3 class="mt-4 text-lg font-semibold leading-tight">
                {e.nombre}{" "}
                {e.detalle && (
                  <span class="block text-sm font-medium text-primary">
                    {e.detalle}
                  </span>
                )}
              </h3>
              <p class="mt-2 text-sm text-base-content/70 leading-relaxed">
                {e.texto}
              </p>
              <ul
                class="mt-auto pt-4 space-y-1 text-sm"
                aria-label={`Qué detecta: ${e.nombre}`}
              >
                {e.detecta.map((d) => (
                  <li class="flex gap-2">
                    <span
                      aria-hidden="true"
                      class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"
                    />
                    {d}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Las 5 áreas -->
  <section
    id="que-analizamos"
    class="seccion scroll-mt-24 text-secondary-content"
    aria-labelledby="areas-heading"
  >
    <div class="reveal">
      <span class="text-sm font-semibold tracking-widest uppercase text-primary">
        {areas.eyebrow}
      </span>
      <h2 id="areas-heading" class="mt-3 text-3xl sm:text-4xl font-semibold">
        {areas.titulo}
      </h2>
      <p
        class="sm:hidden mt-4 inline-flex items-center gap-2 text-sm font-medium text-primary"
        aria-hidden="true"
      >
        Desliza para ver las {areas.items.length} áreas
        <span class="motion-safe:animate-pulse">→</span>
      </p>
    </div>

    <!-- Móvil: carrusel deslizable; asoma la tarjeta siguiente para que se
         vea que hay más. Desde sm: rejilla -->
    <ul
      class="reveal-stagger mt-6 sm:mt-8 -mx-4 px-4 flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-4 pb-2 scrollbar-none [&::-webkit-scrollbar]:hidden sm:mx-0 sm:px-0 sm:pb-0 sm:grid sm:grid-cols-2 lg:grid-cols-5 sm:gap-5 sm:overflow-visible"
    >
      {
        areas.items.map((a) => (
          <li class="w-[82%] shrink-0 snap-start sm:w-auto rounded-3xl border border-base-300 bg-base-100 p-5 sm:p-6 max-lg:last:odd:col-span-2">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[a.icono]}
              />
            </span>
            <h3 class="mt-4 font-semibold">{a.titulo}</h3>
            <ul class="mt-3 space-y-1 text-sm text-base-content/70">
              {a.puntos.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

  </section>

  <!-- Cómo leemos los resultados -->
  <section
    class="card bg-base-100 seccion-card text-secondary-content"
    aria-labelledby="resultados-heading"
  >
    <div class="reveal">
      <span class="text-sm font-semibold tracking-widest uppercase text-primary">
        {resultados.eyebrow}
      </span>
      <h2
        id="resultados-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold"
      >
        {resultados.titulo}
      </h2>
    </div>

    <div
      class="reveal-stagger mt-10 grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-5"
    >
      <!-- Escala I–V -->
      <div class="rounded-3xl bg-base-200 p-6">
        <h3 class="font-semibold">{resultados.escala.titulo}</h3>
        <ol class="mt-4 space-y-2">
          {
            resultados.escala.niveles.map((n, i) => (
              <li class="flex items-center gap-3 text-sm">
                <span
                  class:list={[
                    "flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold",
                    tonosNivel[i],
                  ]}
                >
                  {n.nivel}
                </span>
                <span class="w-16 shrink-0 tabular-nums text-base-content/70">
                  {n.rango}
                </span>
                <span class="font-medium">{n.significado}</span>
              </li>
            ))
          }
        </ol>
        <p class="mt-4 text-xs text-base-content/60">
          {resultados.escala.nota}
        </p>
      </div>

      <!-- Hidratación -->
      <div class="rounded-3xl bg-base-200 p-6">
        <h3 class="font-semibold">{resultados.hidratacion.titulo}</h3>
        <p class="mt-1 text-sm text-base-content/70">
          {resultados.hidratacion.texto}
        </p>
        <dl class="mt-5 grid grid-cols-2 gap-3 text-center">
          <div class="rounded-2xl bg-success/10 p-4 text-success-content">
            <dt class="text-2xl font-semibold tabular-nums">
              {resultados.hidratacion.normal.valor}
            </dt>
            <dd class="mt-1 text-xs font-medium">
              {resultados.hidratacion.normal.texto}
            </dd>
          </div>
          <div class="rounded-2xl bg-primary/10 p-4 text-primary">
            <dt class="text-2xl font-semibold tabular-nums">
              {resultados.hidratacion.deficit.valor}
            </dt>
            <dd class="mt-1 text-xs font-medium">
              {resultados.hidratacion.deficit.texto}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Tipos de piel (Baumann) -->
      <div class="rounded-3xl bg-base-200 p-6">
        <h3 class="font-semibold">{resultados.baumann.titulo}</h3>
        <ul class="mt-5 space-y-4 text-sm">
          {
            resultados.baumann.ejes.map(([a, b]) => (
              <li class="grid grid-cols-[6.5rem_1fr_6.5rem] items-center gap-2">
                <span class="font-medium">{a}</span>
                <span aria-hidden="true" class="relative h-px bg-base-content/20">
                  <span class="absolute left-1/2 top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary" />
                </span>
                <span class="text-right font-medium">{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Oferta, proceso y lema -->
  <Oferta />

  <!-- Preguntas frecuentes -->
  <section
    class="card bg-base-100 seccion-card text-secondary-content"
    aria-labelledby="faq-heading"
  >
    <span
      class="reveal block text-sm font-semibold tracking-widest uppercase text-primary"
    >
      {faq.eyebrow}
    </span>
    <h2
      id="faq-heading"
      class="reveal mt-3 text-3xl sm:text-4xl font-semibold"
    >
      {faq.titulo}
    </h2>

    <div class="mt-8 divide-y divide-base-300 border-y border-base-300">
      {
        preguntas.map((f) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-medium [&::-webkit-details-marker]:hidden">
              {f.pregunta}
              <span
                class="text-primary text-xl leading-none group-open:rotate-45 transition-transform"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-base-content/70 leading-relaxed">
              {f.respuesta}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Ubicación -->
  <Ubication />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
</Layout>
