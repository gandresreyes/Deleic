---
// src/pages/contacto.astro
// Contacto y cómo llegar. Todos los datos salen de src/data/contacto.ts; la
// dirección, el horario y el mapa los pinta Ubication, igual que en el resto
// de páginas. La cabecera copia la tarjeta de EnConstruccion.astro.
import Layout from "../layouts/Layout.astro";
import Ubication from "../components/Ubication.astro";
import { DIRECCION, EMAIL, TELEFONO, whatsapp } from "../data/contacto";
import { migas, negocio } from "../lib/schema";

const site = Astro.site ?? Astro.url;

const descripcion = `Deleic está en ${DIRECCION.calle}, ${DIRECCION.cp} ${DIRECCION.ciudad}, ${DIRECCION.referencia}. Reserva tu cita por WhatsApp o en el ${TELEFONO.visible}.`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      name: "Contacto · Deleic",
      description: descripcion,
      url: new URL("/contacto/", site).href,
      mainEntity: negocio(site),
    },
    migas(site, [["Contacto", "/contacto/"]]),
  ],
};

const icons = {
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
};
---

<Layout
  title="Contacto y cómo llegar al centro en León | Deleic"
  description={descripcion}
>
  <section
    class="relative isolate overflow-hidden card bg-base-100 seccion-card text-secondary-content"
  >
    <!-- Textura de puntos, la misma del resto del sitio -->
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 opacity-[0.12] bg-[radial-gradient(rgb(0_0_0/0.6)_1px,transparent_1px)] bg-size-[18px_18px] mask-[linear-gradient(to_left,black,transparent_45%)]"
    >
    </div>

    <div class="reveal max-w-2xl">
      <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary/8 text-primary">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-7 h-7"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icons.chat}
        />
      </span>

      <span
        class="mt-8 block text-sm font-semibold tracking-widest uppercase text-primary"
      >
        Contacto
      </span>
      <h1 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-balance">
        Contacta con Deleic en León
      </h1>
      <p class="mt-4 text-lg text-base-content/70 text-pretty">
        Reserva tu cita por WhatsApp o por teléfono. Para cualquier otra
        consulta, escríbenos a
        <a
          href={`mailto:${EMAIL}`}
          class="font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary"
          >{EMAIL}</a
        >.
      </p>

      <div class="mt-10 flex flex-wrap gap-3 font-bold">
        <a
          href={whatsapp()}
          target="_blank"
          rel="noopener"
          class="px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-primary text-primary-content"
        >
          Escríbenos por WhatsApp
        </a>
        <a
          href={TELEFONO.href}
          class="inline-flex items-center gap-2 px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-base-100 text-secondary-content border border-base-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons.phone}
          />
          {TELEFONO.visible}
        </a>
      </div>
    </div>
  </section>

  <Ubication />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
