---
// src/pages/depilacion-laser.astro
import Layout from "../layouts/Layout.astro";
import Price from "../components/Depilacion/Price.astro";
import Tecnology from "../components/Depilacion/Tecnology.astro";
import Recomendation from "../components/Depilacion/Recomendation.astro";
import Ubication from "../components/Ubication.astro";
import data from "../data/depilacionLaser.json";
import { whatsapp } from "../data/contacto";
import { migas, negocio } from "../lib/schema";

const { seo, hero, funcionamiento, precios } = data;

// El precio solo vive en el JSON: de ahí salen la descripción, las tarjetas y el schema
const desde = `${Math.min(...precios.grupos.map((g) => g.precio))} €`;
const description = seo.description.replace("{desde}", desde);

// Iconos (trazo, 24x24). Heredan el color con currentColor
const icons: Record<string, string> = {
  cpu: '<rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  users:
    '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20v-.5A5.5 5.5 0 018 14h2a5.5 5.5 0 015.5 5.5v.5"/><path d="M16 4.5a3.5 3.5 0 010 7M18 14a5 5 0 013.5 5v1"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 01-2 2H7a2 2 0 01-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 010-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 010 5"/>',
};

// Schema para buscadores e IAs: el servicio con el precio de cada grupo de zonas
const site = Astro.site ?? Astro.url;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Depilación láser de diodo",
      serviceType: "Depilación láser",
      description,
      url: new URL("/depilacion-laser/", site).href,
      image: new URL(hero.imagen, site).href,
      areaServed: { "@type": "City", name: "León" },
      audience: { "@type": "PeopleAudience", suggestedGender: ["female", "male"] },
      provider: negocio(site),
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: precios.titulo,
        itemListElement: precios.grupos.map((g) => ({
          "@type": "Offer",
          name: `Zona ${g.talla} · ${g.nombre}`,
          description: g.zonas.join(", "),
          price: g.precio,
          priceCurrency: "EUR",
          unitText: "sesión",
        })),
      },
    },
    migas(site, [[hero.titulo, "/depilacion-laser/"]]),
  ],
};
---

<Layout
  title={seo.title}
  description={description}
  image={hero.imagen}
  imageAlt={hero.imagenAlt}
>
  <!-- Hero -->
  <section class="seccion">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-5 text-secondary-content"
    >
      <div class="group relative md:col-span-7 py-7 flex items-end">
        <div>
          <span
            class="text-sm font-semibold tracking-widest uppercase text-primary"
          >
            {hero.eyebrow}
          </span>
          <h1 class="mt-3 text-4xl sm:text-5xl font-semibold">
            {hero.titulo}
          </h1>
          <p class="mt-4 text-base-content/70 text-lg">{hero.subtitulo}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={whatsapp(hero.ctaPrincipal.mensaje)}
              target="_blank"
              rel="noopener"
              class="px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-primary text-primary-content font-bold"
            >
              {hero.ctaPrincipal.texto}
            </a>
            <a
              href={hero.ctaSecundario.href}
              class="px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-base-100 text-secondary-content border border-base-300 font-bold"
            >
              {hero.ctaSecundario.texto}
            </a>
          </div>

          <ul
            class="flex justify-start gap-2 md:gap-6 mt-12 text-[12px] md:text-sm"
          >
            {
              hero.puntos.map((p) => (
                <li class="flex gap-2 items-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-8 h-8 shrink-0 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={icons[p.icono]}
                  />
                  <p class="text-base-content/70 leading-none uppercase">
                    {p.texto[0]} <br /> {p.texto[1]}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="group relative md:col-span-5 hidden md:block">
        <img
          src={hero.imagen}
          width="1066"
          height="1600"
          class="w-full h-100 object-cover rounded-3xl"
          alt={hero.imagenAlt}
          fetchpriority="high"
          transition:name="depilacion-laser"
        />
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section
    class="card bg-base-100 seccion-card"
    aria-labelledby="funcionamiento-heading"
  >
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {funcionamiento.eyebrow}
      </span>
      <h2
        id="funcionamiento-heading"
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {funcionamiento.titulo}
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">{funcionamiento.texto}</p>
    </div>

    <div class="mt-8">
      <div class="relative">
        <!-- línea base -->
        <div
          aria-hidden="true"
          class="absolute top-1.75 left-0 right-0 h-px bg-black/10 hidden md:block"
        >
        </div>

        <ol
          class="reveal-stagger relative grid grid-cols-2 sm:grid-cols-4 gap-8"
        >
          {
            funcionamiento.etapas.map((etapa, i) => (
              <li>
                <div
                  aria-hidden="true"
                  class:list={[
                    "w-3.5 h-3.5 rounded-full mb-4",
                    i === funcionamiento.etapas.length - 1
                      ? "border-2 border-primary bg-base-200"
                      : "bg-primary",
                  ]}
                />
                <p class="text-sm font-semibold text-secondary-content mb-1">
                  {etapa.titulo}
                </p>
                <p class="text-sm text-secondary-content/60 leading-relaxed">
                  {etapa.texto}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <Tecnology />
  <Price />
  <Recomendation />
  <Ubication />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
</Layout>
