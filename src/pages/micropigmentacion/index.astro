---
// src/pages/micropigmentacion/index.astro
import Layout from "../../layouts/Layout.astro";
import Ubication from "../../components/Ubication.astro";
import AntesDespues from "../../components/AntesDespues.astro";
import data from "../../data/micropigmentacion.json";

interface Precio {
  concepto: string;
  precio: string;
}
interface Item {
  nombre: string;
  texto: string;
  resumen?: string;
  duracion?: string;
  nota?: string;
  precios?: Precio[];
  publicar?: boolean;
}
interface Grupo {
  titulo: string;
  texto: string;
  items: Item[];
}

const { seo, hero, intro, tratamientos, tecnicas, resultados, pasos, faq } =
  data;

// Precio de entrada ("desde 200€") calculado con el número inicial de cada tarifa
const numero = (s: string) => {
  const m = s.match(/^(?:Desde\s+)?(\d{1,3}(?:\.\d{3})+|\d+)\s*€/i);
  return m ? Number(m[1].replace(/\./g, "")) : null;
};
const desde = (precios?: Precio[]) => {
  if (!precios?.length) return null;
  const nums = precios
    .map((p) => numero(p.precio))
    .filter((n): n is number => n !== null);
  if (!nums.length) return null;
  const varios = precios.length > 1 || /^desde/i.test(precios[0].precio);
  return `${varios ? "desde " : ""}${Math.min(...nums)}€`;
};

// Solo se muestran los tratamientos con publicar !== false
// y los grupos que se queden con al menos uno
const grupos = (tratamientos.grupos as Grupo[])
  .map((g) => ({
    ...g,
    items: g.items
      .filter((i) => i.publicar !== false)
      .map((i) => ({ ...i, desde: desde(i.precios) })),
  }))
  .filter((g) => g.items.length > 0);

const slugify = (s: string) =>
  s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

// Iconos (trazo, 24x24). Heredan el color con currentColor
const icons: Record<string, string> = {
  pen: '<path d="M4 20l4-1 11-11-3-3L5 16l-1 4z"/><path d="M14 6l3 3"/>',
  sparkles:
    '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>',
  refresh:
    '<path d="M20 11a8 8 0 00-14.9-3M4 4v4h4"/><path d="M4 13a8 8 0 0014.9 3M20 20v-4h-4"/>',
};

// Schema para buscadores e IAs: los servicios con su precio y las preguntas frecuentes
const site = Astro.site ?? Astro.url;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: hero.titulo,
      serviceType: "Maquillaje semipermanente",
      description: seo.description,
      url: new URL("/micropigmentacion/", site).href,
      areaServed: { "@type": "City", name: "León" },
      // Mismo negocio que declara el schema del home
      provider: { "@id": new URL("/#negocio", site).href },
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: tratamientos.titulo,
        itemListElement: grupos.flatMap((g) =>
          g.items.flatMap((item) =>
            (item.precios ?? []).map((p) => ({
              "@type": "Offer",
              name: `${item.nombre} · ${p.concepto}`,
              description: item.texto,
              price: numero(p.precio) ?? undefined,
              priceCurrency: "EUR",
            })),
          ),
        ),
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.items.map((f) => ({
        "@type": "Question",
        name: f.pregunta,
        acceptedAnswer: { "@type": "Answer", text: f.respuesta },
      })),
    },
  ],
};
---

<Layout
  title={seo.title}
  description={seo.description}
  image={hero.imagen}
  imageAlt={hero.imagenAlt}
>
  <!-- Hero -->
  <section class="seccion">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-5 text-secondary-content"
    >
      <div class="group relative md:col-span-7 py-7 flex items-end">
        <div>
          <span
            class="text-sm font-semibold tracking-widest uppercase text-primary"
          >
            {hero.eyebrow}
          </span>
          <h1 class="mt-3 text-4xl sm:text-5xl font-semibold">
            {hero.titulo}
          </h1>
          <p class="mt-4 text-base-content/70 text-lg">{hero.subtitulo}</p>

          <div class="mt-8 flex flex-wrap gap-3 font-bold">
            <a
              href={hero.ctaPrincipal.href}
              target="_blank"
              rel="noopener"
              class="px-4 sm:px-6 py-3 sm:py-4 bg-primary text-primary-content rounded-full"
            >
              {hero.ctaPrincipal.texto}
            </a>
            <a
              href={hero.ctaSecundario.href}
              class="px-4 sm:px-6 py-3 sm:py-4 bg-base-100 text-secondary-content rounded-full border border-base-300"
            >
              {hero.ctaSecundario.texto}
            </a>
          </div>

          <div
            class="flex justify-start gap-2 md:gap-6 mt-12 text-[12px] md:text-sm"
          >
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.pen}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Diseño <br /> previo
              </p>
            </div>
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.sparkles}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Acabado <br /> hiperrealista
              </p>
            </div>
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.refresh}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Retoque <br /> incluido
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="group relative md:col-span-5 hidden md:block">
        <img
          src={hero.imagen}
          class="w-full h-100 object-cover object-left rounded-3xl"
          alt={hero.imagenAlt}
          transition:name="micropigmentacion"
        />
      </div>
    </div>
  </section>

  <!-- Enfoque -->
  <section class="card bg-base-100 seccion-card">
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {intro.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {intro.titulo}
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">{intro.texto}</p>
    </div>

    <div class="mt-8">
      <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-3 gap-8">
        {
          intro.pilares.map((p) => (
            <div>
              <div class="w-3.5 h-3.5 rounded-full mb-4 bg-primary" />
              <p class="text-sm font-semibold text-secondary-content mb-1">
                {p.titulo}
              </p>
              <p class="text-sm text-base-content/70 leading-relaxed">
                {p.texto}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tratamientos y tarifas -->
  <section
    id="tratamientos"
    class="card bg-base-100 seccion-card scroll-mt-24"
  >
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {tratamientos.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {tratamientos.titulo}
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">{tratamientos.texto}</p>

      <!-- Salto rápido a cada grupo -->
      <div class="mt-6 flex flex-wrap gap-2">
        {
          grupos.map((g) => (
            <a
              href={`#${slugify(g.titulo)}`}
              class="px-4 py-2 rounded-full bg-base-200 text-sm font-medium text-secondary-content hover:bg-primary hover:text-primary-content transition-colors"
            >
              {g.titulo}
            </a>
          ))
        }
      </div>
    </div>

    {
      grupos.map((g) => (
        <div
          id={slugify(g.titulo)}
          class="reveal mt-14 grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12 scroll-mt-24"
        >
          <div class="lg:sticky lg:top-28 self-start">
            <h3 class="text-2xl font-semibold text-secondary-content">
              {g.titulo}
            </h3>
            <p class="mt-1 text-base-content/70">{g.texto}</p>
          </div>

          <div class="lg:col-span-2 border-t border-base-300">
            {g.items.map((item) => (
              <details
                name={slugify(g.titulo)}
                class="group border-b border-base-300"
              >
                <summary class="flex items-center gap-4 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-secondary-content group-hover:text-primary transition-colors">
                      {item.nombre}
                    </h4>
                    {item.resumen && (
                      <p class="mt-0.5 text-sm text-base-content/70">
                        {item.resumen}
                      </p>
                    )}
                  </div>
                  {item.desde && (
                    <span class="shrink-0 text-sm font-semibold text-secondary-content">
                      {item.desde}
                    </span>
                  )}
                  <span
                    class="shrink-0 w-8 h-8 rounded-full bg-base-200 text-primary flex items-center justify-center text-lg leading-none group-open:rotate-45 transition-transform"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>

                <div class="pb-6 grid grid-cols-1 md:grid-cols-5 gap-6">
                  <div class="md:col-span-3">
                    <p class="text-sm text-base-content/70 leading-relaxed">
                      {item.texto}
                    </p>
                    {item.duracion && (
                      <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-primary">
                        Duración · {item.duracion}
                      </p>
                    )}
                    {item.nota && (
                      <p class="mt-3 text-xs text-base-content/60 leading-relaxed">
                        {item.nota}
                      </p>
                    )}
                  </div>

                  {item.precios && item.precios.length > 0 && (
                    <ul class="md:col-span-2 self-start rounded-2xl bg-base-200 p-5 space-y-2">
                      {item.precios.map((pr) => (
                        <li class="flex items-baseline justify-between gap-4 text-sm">
                          <span class="text-base-content/70">
                            {pr.concepto}
                          </span>
                          <span class="shrink-0 text-right font-semibold text-secondary-content">
                            {pr.precio}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <!-- Diferencias entre técnicas (misma tarjeta que los protocolos de medicina estética) -->
  <section class="card bg-base-100 seccion-card">
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {tecnicas.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {tecnicas.titulo}
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">{tecnicas.texto}</p>
    </div>

    <div class="reveal-stagger mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
      {
        tecnicas.items.map((t) => (
          <article
            class:list={[
              "flex flex-col rounded-3xl p-6",
              t.destacado
                ? "bg-primary text-primary-content"
                : "bg-base-200 text-secondary-content",
            ]}
          >
            <h3 class="text-xl font-semibold">{t.nombre}</h3>
            <p
              class:list={[
                "mt-2 text-sm leading-relaxed",
                t.destacado
                  ? "text-primary-content/80"
                  : "text-base-content/70",
              ]}
            >
              {t.texto}
            </p>

            <dl
              class:list={[
                "mt-auto pt-4 space-y-1.5 text-sm",
                t.destacado
                  ? "[&>div]:border-white/20"
                  : "[&>div]:border-base-300",
              ]}
            >
              <div class="flex items-baseline justify-between gap-4 border-t pt-1.5">
                <dt
                  class={
                    t.destacado
                      ? "text-primary-content/80"
                      : "text-base-content/70"
                  }
                >
                  Profundidad
                </dt>
                <dd class="shrink-0 text-right font-semibold">
                  {t.profundidad}
                </dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 border-t pt-1.5">
                <dt
                  class={
                    t.destacado
                      ? "text-primary-content/80"
                      : "text-base-content/70"
                  }
                >
                  Duración
                </dt>
                <dd class="shrink-0 text-right font-semibold">{t.duracion}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Antes y después -->
  <section class="card bg-base-100 seccion-card">
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {resultados.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {resultados.titulo}
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">{resultados.texto}</p>
    </div>

    <AntesDespues
      antes={resultados.antes}
      despues={resultados.despues}
      class="reveal-scale mt-8 mx-auto w-full max-w-5xl"
    />
    <p class="mt-4 mx-auto w-full max-w-5xl text-xs text-base-content/60">
      {resultados.nota}
    </p>
  </section>

  <!-- Cómo trabajamos (misma línea de tiempo que depilación láser) -->
  <section class="card bg-base-100 seccion-card">
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {pasos.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {pasos.titulo}
      </h2>
    </div>

    <div class="mt-8">
      <div class="relative">
        <!-- línea base -->
        <div
          class="absolute top-1.75 left-0 right-0 h-px bg-black/10 hidden md:block"
        >
        </div>

        <div class="reveal-stagger relative grid grid-cols-1 sm:grid-cols-3 gap-8">
          {
            pasos.items.map((paso, i) => (
              <div>
                <div
                  class:list={[
                    "w-3.5 h-3.5 rounded-full mb-4",
                    i === pasos.items.length - 1
                      ? "border-2 border-primary bg-base-100"
                      : "bg-primary",
                  ]}
                />
                <p class="text-sm font-semibold text-secondary-content mb-1">
                  {paso.titulo}
                </p>
                <p class="text-sm text-base-content/70 leading-relaxed">
                  {paso.texto}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="card bg-base-100 seccion-card">
    <span class="reveal block text-sm font-semibold tracking-widest uppercase text-primary">
      {faq.eyebrow}
    </span>
    <h2 class="reveal mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content">
      {faq.titulo}
    </h2>

    <div class="reveal-stagger mt-8 divide-y divide-base-300 border-y border-base-300">
      {
        faq.items.map((f) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-medium text-secondary-content">
              {f.pregunta}
              <span
                class="text-primary text-xl leading-none group-open:rotate-45 transition-transform"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-base-content/70 leading-relaxed">
              {f.respuesta}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Ubicación -->
  <Ubication />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
