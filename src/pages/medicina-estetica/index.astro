---
// src/pages/medicina-estetica.astro
import Layout from "../../layouts/Layout.astro";
import Foto from "../../components/Foto.astro";
import { sizesCubre, TRAMOS_HERO } from "../../lib/imagenes";
import Ubication from "../../components/Ubication.astro";
import {
  gruposPublicados,
  numero,
  partirPrecio,
  type Grupo,
  type Precio,
} from "../../lib/precios";
import { faqPage, migas, negocio } from "../../lib/schema";
import { whatsapp } from "../../data/contacto";
import { slugify } from "../../lib/texto";
import data from "../../data/medicinaEstetica.json";

interface Combo {
  nombre: string;
  texto: string;
  nota?: string;
  piezas: string[];
  precios?: Precio[];
  enlaces?: { texto: string; href: string }[];
}

const { seo, hero, tratamientos, combinaciones, ayuda, faq } = data;

const grupos = gruposPublicados(tratamientos.grupos as Grupo[]);

// Iconos (trazo, 24x24). Heredan el color con currentColor
const icons: Record<string, string> = {
  clipboard:
    '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v2H9zM9 13l2 2 4-4"/>',
  sparkles:
    '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>',
  target:
    '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
};

// Schema para buscadores e IAs: los servicios con su precio, la FAQ y las migas
const site = Astro.site ?? Astro.url;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Medicina estética",
      serviceType: "Medicina estética",
      description: seo.description,
      url: new URL("/medicina-estetica/", site).href,
      areaServed: { "@type": "City", name: "León" },
      provider: negocio(site),
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: tratamientos.titulo,
        itemListElement: grupos.flatMap((g) =>
          g.items.flatMap((item) =>
            (item.precios ?? []).map((p) => ({
              "@type": "Offer",
              name: `${item.nombre} · ${p.concepto}`,
              description: item.texto,
              price: numero(p.precio) ?? undefined,
              priceCurrency: "EUR",
            })),
          ),
        ),
      },
    },
    faqPage(faq.items),
    migas(site, [["Medicina estética", "/medicina-estetica/"]]),
  ],
};
---

<Layout title={seo.title} description={seo.description}>
  <!-- Hero -->
  <section class="seccion">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-5 text-secondary-content"
    >
      <div class="group relative md:col-span-7 py-7 flex items-end">
        <div>
          <span
            class="text-sm font-semibold tracking-widest uppercase text-primary"
          >
            {hero.eyebrow}
          </span>
          <h1 class="mt-3 text-4xl sm:text-5xl font-semibold">
            {hero.titulo}
          </h1>
          <p class="mt-4 text-base-content/70 text-lg">{hero.subtitulo}</p>

          <div class="mt-8 flex flex-wrap gap-3 font-bold">
            <a
              href={whatsapp(hero.ctaPrincipal.mensaje)}
              target="_blank"
              rel="noopener"
              class="px-4 sm:px-6 py-3 sm:py-4 bg-primary text-primary-content rounded-full"
            >
              {hero.ctaPrincipal.texto}
            </a>
            <a
              href={hero.ctaSecundario.href}
              class="px-4 sm:px-6 py-3 sm:py-4 bg-base-100 text-secondary-content rounded-full border border-base-300"
            >
              {hero.ctaSecundario.texto}
            </a>
          </div>

          <div
            class="flex justify-start gap-2 md:gap-6 mt-12 text-[12px] md:text-sm"
          >
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.clipboard}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Valoración <br /> sin compromiso
              </p>
            </div>
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.sparkles}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Resultados <br /> naturales
              </p>
            </div>
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.target}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Plan <br /> a tu medida
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="group relative md:col-span-5 hidden md:block">
        <Foto
          src={hero.imagen}
          sizes={sizesCubre(hero.imagen, TRAMOS_HERO)}
          class="w-full h-100 object-cover object-[50%_20%] rounded-3xl"
          alt={hero.imagenAlt}
          transition:name="medicina-estetica"
        />
      </div>
    </div>
  </section>

  <!-- Tratamientos y tarifas. En móvil, pestañas: un grupo cada vez (ver
       "Pestañas en móvil" en global.css); desde lg, todos los grupos -->
  <section
    id="tratamientos"
    data-pestanas
    class="card bg-base-100 seccion-card scroll-mt-24"
  >
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {tratamientos.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {tratamientos.titulo}
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">{tratamientos.texto}</p>
    </div>

    <!-- Chips de grupo, todos a la vista para que se vea el catálogo entero.
         En móvil cambian de pestaña; desde lg, saltan al grupo -->
    <nav aria-label="Grupos de tratamientos" class="mt-6">
      <ul class="flex flex-wrap gap-2">
        {
          grupos.map((g, i) => (
            <li>
              <a
                href={`#${slugify(g.titulo)}`}
                data-pestana
                aria-current={i === 0 ? "true" : undefined}
                class="block whitespace-nowrap px-4 py-2 rounded-full bg-base-200 text-sm font-medium text-secondary-content hover:bg-primary hover:text-primary-content max-lg:aria-current:bg-primary max-lg:aria-current:text-primary-content transition-colors"
              >
                {g.titulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      grupos.map((g, i) => (
        <div
          id={slugify(g.titulo)}
          data-grupo
          data-oculto={i > 0 ? "" : undefined}
          class="reveal mt-8 lg:mt-14 grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12 scroll-mt-24"
        >
          <div class="lg:sticky lg:top-28 self-start">
            <h3 class="text-2xl font-semibold text-secondary-content">
              {g.titulo}
            </h3>
            <p class="mt-1 text-base-content/70">{g.texto}</p>
          </div>

          <div class="lg:col-span-2 border-t border-base-300">
            {g.items.map((item) => (
              <details
                name={slugify(g.titulo)}
                class="group border-b border-base-300"
              >
                <summary class="flex items-center gap-4 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-secondary-content group-hover:text-primary transition-colors">
                      {item.nombre}
                    </h4>
                    {item.resumen && (
                      <p class="mt-0.5 text-sm text-base-content/70">
                        {item.resumen}
                      </p>
                    )}
                  </div>
                  {item.desde && (
                    <span class="shrink-0 text-sm font-semibold text-secondary-content">
                      {item.desde}
                    </span>
                  )}
                  <span
                    class="shrink-0 w-8 h-8 rounded-full bg-base-200 text-primary flex items-center justify-center text-lg leading-none group-open:rotate-45 transition-transform"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>

                <div class="pb-6 grid grid-cols-1 md:grid-cols-5 gap-6">
                  <div class="md:col-span-3">
                    <p class="text-sm text-base-content/70 leading-relaxed">
                      {item.texto}
                    </p>
                    {/* La etiqueta en mayúsculas; el dato, en texto normal: una
                        frase larga en mayúsculas cuesta de leer */}
                    {item.duracion && (
                      <p class="mt-3 text-sm text-base-content/70 leading-relaxed">
                        <span class="block text-xs font-semibold uppercase tracking-wider text-primary">
                          Duración
                        </span>
                        {item.duracion}
                      </p>
                    )}
                    {item.nota && (
                      <p class="mt-3 text-xs text-base-content/65 leading-relaxed">
                        {item.nota}
                      </p>
                    )}
                  </div>

                  {item.precios && item.precios.length > 0 && (
                    <ul class="md:col-span-2 self-start rounded-2xl bg-base-200 p-5 space-y-2">
                      {item.precios.map((pr) => {
                        const { precio, extra } = partirPrecio(pr.precio);
                        return (
                          <li class="flex items-baseline justify-between gap-4 text-sm">
                            <span class="text-base-content/70">{pr.concepto}</span>
                            <span class="shrink-0 text-right font-semibold text-secondary-content">
                              {precio}
                              {extra && (
                                <span class="block text-xs font-normal text-base-content/65">
                                  {extra}
                                </span>
                              )}
                            </span>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </div>
              </details>
            ))}

            {/* Móvil: pasar al grupo siguiente sin volver a los chips, para
                quien quiere verlo todo (desde lg ya se ven todos) */}
            {grupos[i + 1] && (
              <a
                href={`#${slugify(grupos[i + 1].titulo)}`}
                data-siguiente
                class="lg:hidden mt-6 flex items-center justify-center gap-2 px-4 py-3 rounded-full bg-base-100 text-secondary-content border border-base-300 font-bold"
              >
                Siguiente: {grupos[i + 1].titulo}
                <span class="text-primary" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      ))
    }

    <!-- Para quien no sabe qué elegir (la mayoría). Misma tarjeta que el
         "¿Por qué?" del Método Deleic; en móvil queda tras el grupo abierto -->
    <div
      class="reveal mt-10 lg:mt-14 flex items-start gap-4 rounded-3xl bg-base-200 p-6"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-8 h-8 shrink-0 text-primary"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={icons.clipboard}
      />
      <div>
        <h3 class="font-semibold text-secondary-content">{ayuda.titulo}</h3>
        <p class="mt-1 text-base-content/70">{ayuda.texto}</p>
        <a
          href={whatsapp(ayuda.cta.mensaje)}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-block px-4 sm:px-6 py-3 sm:py-4 rounded-full bg-primary text-primary-content font-bold"
        >
          {ayuda.cta.texto}
        </a>
      </div>
    </div>
  </section>

  <!-- Protocolos combinados: bloque burdeos (el de "Novedad" en las fichas)
       para romper la página; en móvil, carrusel horizontal (el de "Otros
       tratamientos") -->
  <section
    aria-labelledby="combinaciones-titulo"
    class="relative isolate overflow-hidden card seccion-card bg-primary text-base-100"
  >
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-[radial-gradient(110%_80%_at_100%_0%,var(--color-primary-claro)_0%,transparent_60%),radial-gradient(80%_70%_at_0%_100%,var(--color-primary-oscuro)_0%,transparent_65%)]"
    >
    </div>
    <div aria-hidden="true" class="textura-cursor"></div>

    <div class="reveal">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-base-100/10 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] ring-1 ring-base-100/20 backdrop-blur-sm"
      >
        {combinaciones.eyebrow}
      </span>
      <h2
        id="combinaciones-titulo"
        class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight"
      >
        {combinaciones.titulo}
      </h2>
      <p class="mt-4 text-lg text-base-100/75 text-pretty">
        {combinaciones.texto}
      </p>
    </div>

    <!-- El reveal va en un envoltorio: dentro de un carrusel, la subida de
         .reveal-stagger se recortaría -->
    <div class="reveal mt-8">
      <div
        class="-mx-6 sm:-mx-10 md:mx-0 px-6 sm:px-10 md:px-0 flex md:grid md:grid-cols-3 gap-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-px-6 sm:scroll-px-10 pb-2 md:pb-0 scrollbar-none [&::-webkit-scrollbar]:hidden"
      >
        {
          (combinaciones.items as Combo[]).map((c) => (
            <article class="shrink-0 w-[82%] sm:w-[60%] md:w-auto snap-start flex flex-col rounded-3xl bg-white/10 p-6 ring-1 ring-white/20 backdrop-blur-sm">
              <div class="flex flex-wrap items-center gap-2">
                {c.piezas.map((pieza, i) => (
                  <>
                    {i > 0 && (
                      <span class="text-sm text-base-100/65" aria-hidden="true">
                        +
                      </span>
                    )}
                    <span class="rounded-full bg-white/10 ring-1 ring-white/20 px-3 py-1 text-xs">
                      {pieza}
                    </span>
                  </>
                ))}
              </div>

              <h3 class="mt-5 text-xl font-semibold">{c.nombre}</h3>
              <p class="mt-2 text-sm text-base-100/75 leading-relaxed text-pretty">
                {c.texto}
              </p>
              {c.nota && (
                <p class="mt-3 text-xs text-base-100/65 leading-relaxed">
                  {c.nota}
                </p>
              )}

              {c.precios && c.precios.length > 0 && (
                <ul class="mt-auto pt-5 divide-y divide-base-100/15">
                  {c.precios.map((p) => (
                    <li class="flex items-baseline justify-between gap-4 py-3 first:pt-0 last:pb-0">
                      <span class="text-[15px] font-medium leading-snug">
                        {p.concepto}
                      </span>
                      <span class="shrink-0 text-xl font-semibold tracking-tight tabular-nums">
                        {p.precio}
                      </span>
                    </li>
                  ))}
                </ul>
              )}

              {c.enlaces && (
                <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1">
                  {c.enlaces.map((e) => (
                    <a
                      href={e.href}
                      class="text-sm font-medium text-base-100 underline decoration-base-100/40 underline-offset-4 hover:decoration-base-100"
                    >
                      {e.texto} →
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="card bg-base-100 seccion-card">
    <span class="reveal block text-sm font-semibold tracking-widest uppercase text-primary">
      {faq.eyebrow}
    </span>
    <h2 class="reveal mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content">
      {faq.titulo}
    </h2>

    <div class="reveal-stagger mt-8 divide-y divide-base-300 border-y border-base-300">
      {
        faq.items.map((f) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-medium text-secondary-content">
              {f.pregunta}
              <span
                class="text-primary text-xl leading-none group-open:rotate-45 transition-transform"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-base-content/70 leading-relaxed">
              {f.respuesta}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Ubicación -->
  <Ubication />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>

<script>
  // Pestañas de tratamientos en móvil: los chips y los botones "Siguiente"
  // enseñan un grupo y ocultan el resto (solo por debajo de lg; ver
  // "Pestañas en móvil" en global.css). Desde lg son saltos normales al grupo.
  // Con ClientRouter hay que engancharlas de nuevo en cada navegación
  const movil = matchMedia("(width < 64rem)");
  const sinAnimacion = matchMedia("(prefers-reduced-motion: reduce)");
  // El aviso de cambio de ancho va en `movil`, que sobrevive a cada
  // navegación: se quita el de la visita anterior antes de poner el nuevo
  let escucha = new AbortController();

  function iniciarPestanas() {
    escucha.abort();
    escucha = new AbortController();
    const seccion = document.querySelector<HTMLElement>("[data-pestanas]");
    if (!seccion) return;
    const chips = [
      ...seccion.querySelectorAll<HTMLAnchorElement>("[data-pestana]"),
    ];
    const grupos = [...seccion.querySelectorAll<HTMLElement>("[data-grupo]")];

    const marcar = (grupo: HTMLElement) =>
      chips.forEach((c) =>
        c.hash === `#${grupo.id}`
          ? c.setAttribute("aria-current", "true")
          : c.removeAttribute("aria-current"),
      );

    // En móvil, los grupos con data-oculto se ocultan con hidden="until-found"
    // (ver "Pestañas en móvil" en global.css); desde lg se ven todos. Donde
    // el navegador no conoce until-found (Safari), hidden a secas: su
    // display: none sí puede con el display: grid del grupo
    const valorOculto = "onbeforematch" in document.body ? "until-found" : "";
    const sincronizar = () =>
      grupos.forEach((g) =>
        movil.matches && g.hasAttribute("data-oculto")
          ? g.setAttribute("hidden", valorOculto)
          : g.removeAttribute("hidden"),
      );

    const mostrar = (grupo: HTMLElement) => {
      grupos.forEach((g) => g.toggleAttribute("data-oculto", g !== grupo));
      sincronizar();
      // Sin la animación de .reveal: al pasar de oculto a visible, el
      // navegador la repetiría entera (1 s) cada vez
      grupo.classList.add("is-visible");
      grupo.style.animation = "none";
    };

    // Transición en dos tiempos, sin que se monten los textos: el grupo actual
    // se desvanece, se cambia (y con "Siguiente" se sube, mientras no se ve
    // nada) y el nuevo entra subiendo un poco. Con "reducir movimiento", el
    // cambio es directo
    let cambiando = false;
    const cambiar = async (grupo: HTMLElement, subir: boolean) => {
      if (cambiando) return;
      cambiando = true;
      marcar(grupo);
      const animar = !sinAnimacion.matches;
      const actual = grupos.find((g) => !g.hasAttribute("data-oculto"));
      try {
        if (animar && actual) {
          await actual.animate(
            [{ opacity: 1 }, { opacity: 0, transform: "translateY(-8px)" }],
            { duration: 180, easing: "ease-in", fill: "forwards" },
          ).finished;
        }
        mostrar(grupo);
        // Quita el "forwards" para que vuelva a verse si se elige otra vez
        actual?.getAnimations().forEach((a) => a.cancel());
        if (subir) grupo.scrollIntoView({ block: "start" });
        if (animar) {
          await grupo.animate(
            [
              { opacity: 0, transform: "translateY(16px)" },
              { opacity: 1, transform: "none" },
            ],
            { duration: 400, easing: "cubic-bezier(0.2, 0.6, 0.2, 1)" },
          ).finished;
        }
      } finally {
        cambiando = false;
      }
    };

    // Los chips están justo encima del grupo: no hace falta mover la página.
    // "Siguiente" está al final del grupo anterior: se sube al principio del
    // nuevo para leerlo desde arriba
    seccion
      .querySelectorAll<HTMLAnchorElement>("[data-pestana], [data-siguiente]")
      .forEach((enlace) =>
        enlace.addEventListener("click", (e) => {
          if (!movil.matches) return;
          const grupo = grupos.find((g) => `#${g.id}` === enlace.hash);
          if (!grupo) return;
          e.preventDefault();
          if (grupo.hasAttribute("data-oculto")) {
            cambiar(grupo, enlace.hasAttribute("data-siguiente"));
          }
        }),
      );

    // El script toma el relevo del CSS: los ocultos pasan a hidden en el
    // mismo paso, sin que se llegue a pintar nada entre medias
    sincronizar();
    seccion.setAttribute("data-listo", "");
    movil.addEventListener("change", sincronizar, { signal: escucha.signal });

    // "Buscar en la página" o un enlace de Google ha encontrado texto en un
    // grupo oculto: el navegador avisa antes de enseñarlo y se cambia a esa
    // pestaña, sin animación, porque el navegador ya baja hasta el texto
    grupos.forEach((g) =>
      g.addEventListener("beforematch", () => {
        marcar(g);
        mostrar(g);
      }),
    );

    // Llegada con un grupo en la URL (/medicina-estetica/#cabello): se abre
    // ese y se baja hasta él, que oculto no tenía dónde hacer scroll
    const pedido = grupos.find((g) => `#${g.id}` === location.hash);
    if (movil.matches && pedido?.hasAttribute("data-oculto")) {
      marcar(pedido);
      mostrar(pedido);
      pedido.scrollIntoView({ block: "start" });
    }
  }

  document.addEventListener("astro:page-load", iniciarPestanas);
</script>
