---
// src/pages/medicina-estetica.astro
import Layout from "../../layouts/Layout.astro";
import Ubication from "../../components/Ubication.astro";
import { gruposPublicados, numero, type Grupo, type Precio } from "../../lib/precios";
import { faqPage, migas, negocio } from "../../lib/schema";
import { whatsapp } from "../../data/contacto";
import data from "../../data/medicinaEstetica.json";

interface Combo {
  nombre: string;
  texto: string;
  nota?: string;
  piezas: string[];
  precios?: Precio[];
  enlaces?: { texto: string; href: string }[];
}

const { seo, hero, intro, tratamientos, combinaciones, pasos, faq } = data;

const grupos = gruposPublicados(tratamientos.grupos as Grupo[]);

const slugify = (s: string) =>
  s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

// Iconos (trazo, 24x24). Heredan el color con currentColor
const icons: Record<string, string> = {
  clipboard:
    '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v2H9zM9 13l2 2 4-4"/>',
  sparkles:
    '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>',
  target:
    '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
};

// Schema para buscadores e IAs: los servicios con su precio, la FAQ y las migas
const site = Astro.site ?? Astro.url;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Medicina estética",
      serviceType: "Medicina estética",
      description: seo.description,
      url: new URL("/medicina-estetica/", site).href,
      areaServed: { "@type": "City", name: "León" },
      provider: negocio(site),
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: tratamientos.titulo,
        itemListElement: grupos.flatMap((g) =>
          g.items.flatMap((item) =>
            (item.precios ?? []).map((p) => ({
              "@type": "Offer",
              name: `${item.nombre} · ${p.concepto}`,
              description: item.texto,
              price: numero(p.precio) ?? undefined,
              priceCurrency: "EUR",
            })),
          ),
        ),
      },
    },
    faqPage(faq.items),
    migas(site, [["Medicina estética", "/medicina-estetica/"]]),
  ],
};
---

<Layout title={seo.title} description={seo.description}>
  <!-- Hero -->
  <section class="seccion">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-5 text-secondary-content"
    >
      <div class="group relative md:col-span-7 py-7 flex items-end">
        <div>
          <span
            class="text-sm font-semibold tracking-widest uppercase text-primary"
          >
            {hero.eyebrow}
          </span>
          <h1 class="mt-3 text-4xl sm:text-5xl font-semibold">
            {hero.titulo}
          </h1>
          <p class="mt-4 text-base-content/70 text-lg">{hero.subtitulo}</p>

          <div class="mt-8 flex flex-wrap gap-3 font-bold">
            <a
              href={whatsapp(hero.ctaPrincipal.mensaje)}
              target="_blank"
              rel="noopener"
              class="px-4 sm:px-6 py-3 sm:py-4 bg-primary text-primary-content rounded-full"
            >
              {hero.ctaPrincipal.texto}
            </a>
            <a
              href={hero.ctaSecundario.href}
              class="px-4 sm:px-6 py-3 sm:py-4 bg-base-100 text-secondary-content rounded-full border border-base-300"
            >
              {hero.ctaSecundario.texto}
            </a>
          </div>

          <div
            class="flex justify-start gap-2 md:gap-6 mt-12 text-[12px] md:text-sm"
          >
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.clipboard}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Valoración <br /> sin compromiso
              </p>
            </div>
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.sparkles}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Resultados <br /> naturales
              </p>
            </div>
            <div class="flex gap-2 items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-8 h-8 shrink-0 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons.target}
              />
              <p class="text-base-content/70 leading-none uppercase">
                Plan <br /> a tu medida
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="group relative md:col-span-5 hidden md:block">
        <img
          src={hero.imagen}
          class="w-full h-100 object-cover rounded-3xl"
          alt={hero.imagenAlt}
          transition:name="medicina-estetica"
        />
      </div>
    </div>
  </section>

  <!-- Enfoque -->
  <section class="card bg-base-100 seccion-card">
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {intro.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {intro.titulo}
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">{intro.texto}</p>
    </div>

    <div class="mt-8">
      <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-3 gap-8">
        {
          intro.pilares.map((p) => (
            <div>
              <div class="w-3.5 h-3.5 rounded-full mb-4 bg-primary" />
              <p class="text-sm font-semibold text-secondary-content mb-1">
                {p.titulo}
              </p>
              <p class="text-sm text-base-content/70 leading-relaxed">
                {p.texto}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tratamientos y tarifas -->
  <section id="tratamientos" class="card bg-base-100 seccion-card scroll-mt-24">
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {tratamientos.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {tratamientos.titulo}
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">{tratamientos.texto}</p>

      <!-- Salto rápido a cada grupo -->
      <div class="mt-6 flex flex-wrap gap-2">
        {
          grupos.map((g) => (
            <a
              href={`#${slugify(g.titulo)}`}
              class="px-4 py-2 rounded-full bg-base-200 text-sm font-medium text-secondary-content hover:bg-primary hover:text-primary-content transition-colors"
            >
              {g.titulo}
            </a>
          ))
        }
      </div>
    </div>

    {
      grupos.map((g) => (
        <div
          id={slugify(g.titulo)}
          class="reveal mt-14 grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12 scroll-mt-24"
        >
          <div class="lg:sticky lg:top-28 self-start">
            <h3 class="text-2xl font-semibold text-secondary-content">
              {g.titulo}
            </h3>
            <p class="mt-1 text-base-content/70">{g.texto}</p>
          </div>

          <div class="lg:col-span-2 border-t border-base-300">
            {g.items.map((item) => (
              <details
                name={slugify(g.titulo)}
                class="group border-b border-base-300"
              >
                <summary class="flex items-center gap-4 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-secondary-content group-hover:text-primary transition-colors">
                      {item.nombre}
                    </h4>
                    {item.resumen && (
                      <p class="mt-0.5 text-sm text-base-content/70">
                        {item.resumen}
                      </p>
                    )}
                  </div>
                  {item.desde && (
                    <span class="shrink-0 text-sm font-semibold text-secondary-content">
                      {item.desde}
                    </span>
                  )}
                  <span
                    class="shrink-0 w-8 h-8 rounded-full bg-base-200 text-primary flex items-center justify-center text-lg leading-none group-open:rotate-45 transition-transform"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>

                <div class="pb-6 grid grid-cols-1 md:grid-cols-5 gap-6">
                  <div class="md:col-span-3">
                    <p class="text-sm text-base-content/70 leading-relaxed">
                      {item.texto}
                    </p>
                    {item.duracion && (
                      <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-primary">
                        Duración · {item.duracion}
                      </p>
                    )}
                    {item.nota && (
                      <p class="mt-3 text-xs text-base-content/60 leading-relaxed">
                        {item.nota}
                      </p>
                    )}
                  </div>

                  {item.precios && item.precios.length > 0 && (
                    <ul class="md:col-span-2 self-start rounded-2xl bg-base-200 p-5 space-y-2">
                      {item.precios.map((pr) => (
                        <li class="flex items-baseline justify-between gap-4 text-sm">
                          <span class="text-base-content/70">
                            {pr.concepto}
                          </span>
                          <span class="shrink-0 text-right font-semibold text-secondary-content">
                            {pr.precio}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <!-- Protocolos combinados -->
  <section class="card bg-base-100 seccion-card">
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {combinaciones.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {combinaciones.titulo}
      </h2>
      <p class="mt-4 text-base-content/70 text-lg">{combinaciones.texto}</p>
    </div>

    <div class="reveal-stagger mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
      {
        (combinaciones.items as Combo[]).map((c) => (
          <article class="flex flex-col rounded-3xl bg-base-200 p-6">
            <div class="flex flex-wrap items-center gap-2">
              {c.piezas.map((pieza, i) => (
                <>
                  {i > 0 && <span class="text-sm text-base-content/40">+</span>}
                  <span class="rounded-full border border-base-300 bg-base-100 px-3 py-1 text-xs text-secondary-content">
                    {pieza}
                  </span>
                </>
              ))}
            </div>

            <h3 class="mt-5 text-xl font-semibold text-secondary-content">
              {c.nombre}
            </h3>
            <p class="mt-2 text-sm text-base-content/70 leading-relaxed">
              {c.texto}
            </p>
            {c.nota && (
              <p class="mt-3 text-xs text-base-content/60 leading-relaxed">
                {c.nota}
              </p>
            )}

            {c.precios && c.precios.length > 0 && (
              <ul class="mt-auto pt-4 space-y-1.5">
                {c.precios.map((p) => (
                  <li class="flex items-baseline justify-between gap-4 border-t border-base-300 pt-1.5 text-sm">
                    <span class="text-base-content/70">{p.concepto}</span>
                    <span class="shrink-0 text-right font-semibold text-secondary-content">
                      {p.precio}
                    </span>
                  </li>
                ))}
              </ul>
            )}

            {c.enlaces && (
              <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1">
                {c.enlaces.map((e) => (
                  <a
                    href={e.href}
                    class="text-sm font-medium text-primary hover:underline"
                  >
                    {e.texto} →
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- Cómo trabajamos (misma línea de tiempo que depilación láser) -->
  <section class="card bg-base-100 seccion-card">
    <div class="reveal">
      <span
        class="text-sm font-semibold tracking-widest uppercase text-primary"
      >
        {pasos.eyebrow}
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content"
      >
        {pasos.titulo}
      </h2>
    </div>

    <div class="mt-8">
      <div class="relative">
        <!-- línea base -->
        <div
          class="absolute top-1.75 left-0 right-0 h-px bg-black/10 hidden md:block"
        >
        </div>

        <div class="reveal-stagger relative grid grid-cols-1 sm:grid-cols-3 gap-8">
          {
            pasos.items.map((paso, i) => (
              <div>
                <div
                  class:list={[
                    "w-3.5 h-3.5 rounded-full mb-4",
                    i === pasos.items.length - 1
                      ? "border-2 border-primary bg-base-100"
                      : "bg-primary",
                  ]}
                />
                <p class="text-sm font-semibold text-secondary-content mb-1">
                  {paso.titulo}
                </p>
                <p class="text-sm text-base-content/70 leading-relaxed">
                  {paso.texto}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="card bg-base-100 seccion-card">
    <span class="reveal block text-sm font-semibold tracking-widest uppercase text-primary">
      {faq.eyebrow}
    </span>
    <h2 class="reveal mt-3 text-3xl sm:text-4xl font-semibold text-secondary-content">
      {faq.titulo}
    </h2>

    <div class="reveal-stagger mt-8 divide-y divide-base-300 border-y border-base-300">
      {
        faq.items.map((f) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-medium text-secondary-content">
              {f.pregunta}
              <span
                class="text-primary text-xl leading-none group-open:rotate-45 transition-transform"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-base-content/70 leading-relaxed">
              {f.respuesta}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Ubicación -->
  <Ubication />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
